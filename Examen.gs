var EXAM = {"especialidades": {"neonatologia": {"nombre": "Neonatología", "disciplinas": ["Neonatología", "Medicina crítica"], "items": [2, 19, 35, 38, 41, 52, 55, 62, 64, 67, 85, 91, 97, 113, 127, 133], "materias": {"2": "Neonatología", "19": "Neonatología", "35": "Medicina crítica", "38": "Neonatología", "41": "Neonatología", "52": "Neonatología", "55": "Neonatología", "62": "Neonatología", "64": "Neonatología", "67": "Medicina crítica", "85": "Medicina crítica", "91": "Neonatología", "97": "Neonatología", "113": "Neonatología", "127": "Neonatología", "133": "Neonatología"}}, "gastroenterologia": {"nombre": "Gastroenterología pediátrica", "disciplinas": ["Gastroenterología y nutrición", "Errores innatos del metabolismo"], "items": [28, 36, 45, 50, 59, 81, 89, 101, 102, 125, 150], "materias": {"28": "Gastroenterología y nutrición", "36": "Gastroenterología y nutrición", "45": "Gastroenterología y nutrición", "50": "Gastroenterología y nutrición", "59": "Gastroenterología y nutrición", "81": "Gastroenterología y nutrición", "89": "Errores innatos del metabolismo", "101": "Gastroenterología y nutrición", "102": "Errores innatos del metabolismo", "125": "Gastroenterología y nutrición", "150": "Gastroenterología y nutrición"}}, "critico": {"nombre": "Manejo del paciente pediátrico en estado crítico", "disciplinas": ["Medicina crítica", "Urgencias pediátricas", "Líquidos y electrolitos", "Neumología", "Farmacología y toxicología"], "items": [6, 11, 27, 29, 35, 49, 51, 54, 57, 67, 85, 87, 92, 93, 100, 109, 112, 123, 131, 132], "materias": {"6": "Neumología", "11": "Neumología", "27": "Farmacología y toxicología", "29": "Urgencias pediátricas", "35": "Medicina crítica", "49": "Urgencias pediátricas", "51": "Líquidos y electrolitos", "54": "Urgencias pediátricas", "57": "Farmacología y toxicología", "67": "Medicina crítica", "85": "Medicina crítica", "87": "Neumología", "92": "Neumología", "93": "Farmacología y toxicología", "100": "Líquidos y electrolitos", "109": "Neumología", "112": "Neumología", "123": "Farmacología y toxicología", "131": "Farmacología y toxicología", "132": "Urgencias pediátricas"}}, "oncologia": {"nombre": "Oncología pediátrica", "disciplinas": ["Hematología y oncología", "Genética"], "items": [8, 13, 16, 26, 37, 47, 61, 66, 74, 82, 111, 114, 120, 124, 137], "materias": {"8": "Hematología y oncología", "13": "Genética", "16": "Hematología y oncología", "26": "Genética", "37": "Genética", "47": "Hematología y oncología", "61": "Hematología y oncología", "66": "Hematología y oncología", "74": "Genética", "82": "Genética", "111": "Hematología y oncología", "114": "Genética", "120": "Hematología y oncología", "124": "Genética", "137": "Hematología y oncología"}}, "cirugia": {"nombre": "Cirugía pediátrica", "disciplinas": ["Ortopedia", "Urgencias pediátricas", "Medicina crítica"], "items": [29, 35, 48, 49, 54, 63, 67, 85, 86, 129, 132], "materias": {"29": "Urgencias pediátricas", "35": "Medicina crítica", "48": "Ortopedia", "49": "Urgencias pediátricas", "54": "Urgencias pediátricas", "63": "Ortopedia", "67": "Medicina crítica", "85": "Medicina crítica", "86": "Ortopedia", "129": "Ortopedia", "132": "Urgencias pediátricas"}}}, "preguntas": {"1": {"stem": "mente bien controlada. Refiere que hace 4 días se cayó en el parque y se raspó la rodilla. Esta mañana despertó con enrojecimiento, aumento de volumen y dolor alrededor de la abrasión. La madre del niño es médica, y su her‐ mana menor ha recibido tratamiento por varios abscesos cutáneos. El niño tiene buen estado general, con signos vitales normales para la edad y sin fiebre. Presenta una abrasión superficial de 2 × 1 cm sobre la rótula izquierda, con aproximadamente 3 cm de eritema y edema circundantes. La zona es dolorosa, sin fluctuación. Los arcos de movilidad de la rodilla son completos. Se palpan varios ganglios aumentados de tamaño, no dolorosos, en la re‐ gión inguinal izquierda. El resto de la exploración física es normal. De las siguientes opciones, el tratamiento MÁS adecuado es", "options": ["amoxicilina", "cefalexina", "clindamicina", "doxiciclina"]}, "2": {"stem": "Un recién nacido de 35 4/7 semanas de gestación ingresa a la Unidad de Cuidados Intensivos Neonatales (UCIN) por dificultad respiratoria. La madre es negativa para estreptococo del grupo B. El embarazo se complicó con hi‐ pertensión gestacional leve. Se realizó cesárea primaria por falla en la inducción del trabajo de parto. Se observó líquido amniótico meconial. El Apgar fue de 8 al minuto y a los 5 minutos. La madre tuvo una temperatura de 38 °C durante 1 hora después del nacimiento. El neonato se coloca en presión positiva continua en la vía aérea (CPAP). Se toma hemocultivo y se inicia ampicilina con gentamicina, ya que preocupa una sepsis neonatal de ini‐ cio temprano. De los siguientes, el factor de la historia de este neonato que se asocia MÁS estrechamente con este diagnóstico es", "options": ["el nacimiento por cesárea", "la hipertensión gestacional materna", "el líquido amniótico meconial", "la edad gestacional pretérmino"]}, "3": {"stem": "Un niño de 10 años acude a consulta por inicio súbito de orina color “refresco de cola”. No refiere dolor, ardor ni expulsión de coágulos al orinar. Desde hace 2 días tiene dolor de garganta y tos leve. No presenta dolor en flan‐ cos, fiebre, exantema ni artralgias. Hace 6 meses tuvo un episodio similar de orina oscura e indolora que se resol‐ vió sin tratamiento. No hay antecedentes familiares de enfermedad renal. Tiene una frecuencia cardiaca de 86 latidos/min, una frecuencia respiratoria de 14 respiraciones/min y una presión arterial de 128/82 mm Hg. Los cam‐ pos pulmonares están limpios. El resto de la exploración física no muestra alteraciones. Se muestran los resulta‐ dos de laboratorio: Prueba Resultado Sangre Leucocitos 7,400/µL (7.4 × 109/L) Hemoglobina 12.8 g/dL (128 g/L) Plaquetas 360 × 103/µL (360 × 109/L) Nitrógeno ureico en sangre (BUN) 36 mg/dL (12.9 mmol/L) Creatinina 0.9 mg/dL (80 µmol/L) Complemento C3 110 mg/dL (1.10 g/L) (referencia, 85-142 mg/dL [0.85-1.42 g/L]) Complemento C4 24 mg/dL (0.24 g/L) (referencia, 12-41 mg/dL [0.12-0.41 g/L]) Antiestreptolisinas O < 200 UI Orina Sangre 3+ Leucocitos 5-10/campo Eritrocitos 50-100/campo Proteínas 3+ De las siguientes opciones, el diagnóstico MÁS probable en este niño es", "options": ["cistitis hemorrágica aguda", "nefropatía por inmunoglobulina A", "glomerulonefritis postestreptocócica", "nefritis lúpica"]}, "4": {"stem": "Una mujer con 30 semanas de gestación acude al consultorio de su obstetra por un cuadro febril. Sus síntomas incluyen cefalea y dolor articular. Ha llevado control prenatal de rutina y no ha tenido complicaciones del emba‐ razo. En la exploración física se observa el exantema que se muestra en la Figura 4. La paciente pregunta cómo podría afectar esta enfermedad a su bebé. Figura 4. Exantema de la mujer descrita en el caso. Cortesía de George Nankervis; tomado de Kimberlin DW, et al, eds. Red Book Online. Itasca, IL: American Academy of Pediatrics; 2018. De las siguientes, la respuesta MÁS precisa es que una secuela probable es", "options": ["calcificaciones en el sistema nervioso central", "coriorretinitis", "edema generalizado", "hipoacusia"]}, "5": {"stem": "Un niño de 11 años es valorado por dolor en la cara anterior de ambas rodillas. Refiere un inicio gradual del dolor después de comenzar a entrenar en un programa local de desarrollo de futbol. Niega lesión aguda. El dolor es progresivo y, en las últimas semanas, ha presentado aumento de volumen localizado unos centímetros por debajo de las rótulas. En sus antecedentes destacan múltiples episodios de dolor crónico en talones y piernas durante los últimos años. Por lo demás está sano, con crecimiento y desarrollo normales. Desde el año pasado entrena todo el año con un equipo de futbol de competencia que viaja a torneos; además, le gusta jugar basquetbol y beisbol. Su entrenador de futbol le recomendó recientemente que se enfoque más en el futbol y deje los demás deportes. En la exploración física, el niño presenta claudicación importante. Hay aumento de volumen y dolor a la palpación bilaterales sobre las tuberosidades tibiales, así como dolor con la extensión de las rodillas contra resis‐ tencia. El resto de la exploración es normal. Se le orienta sobre cómo manejar su dolor de rodilla actual y reducir el riesgo de lesiones futuras. De las siguientes, la MEJOR recomendación para este niño sería", "options": ["seguir la recomendación de su entrenador respecto a la participación deportiva", "usar plantillas acolchadas en sus zapatos de futbol (tachones)", "buscar entrenamiento adicional con un especialista certificado en acondicionamiento físico", "pasar al menos 2 a 3 meses al año sin participar en deportes organizados"]}, "6": {"stem": "Una adolescente de 17 años acude por obstrucción nasal crónica. Refiere que desde hace varios meses no puede respirar por la nariz. Tiene antecedentes de bronquitis y sinusitis de repetición y de tos crónica. En el inte‐ rrogatorio por aparatos y sistemas destacan evacuaciones voluminosas que dejan una película grasosa en el inodoro. Los antecedentes familiares no son contributorios. En la exploración física, su peso está en el percentil 80 y su índice de masa corporal en el percentil 78. Hay obstrucción nasal bilateral por material polipoide que ocupa ambas fosas nasales. La orofaringe está limpia. En el tórax solo destacan algunos estertores crepitantes inspiratorios en la región posterior del hemitórax superior izquierdo; no hay sibilancias. El choque de punta se lo‐ caliza en la línea medioclavicular izquierda. El abdomen es blando, sin hepatoesplenomegalia. No hay hipocra‐ tismo digital. La IgE sérica es normal y la prueba de radioalergoabsorción (RAST) para múltiples aeroalérgenos es negativa. Las pruebas de función pulmonar muestran un patrón mixto (restrictivo y obstructivo) leve, sin respuesta al broncodilatador. De los siguientes, el paso diagnóstico MÁS adecuado a continuación es", "options": ["análisis de mutaciones del gen CFTR", "tomografía computarizada de senos paranasales", "cuantificación de inmunoglobulinas séricas", "determinación de cloro en sudor"]}, "7": {"stem": "Una niña de 12 años, previamente sana y con desarrollo normal, acude a consulta después de haber sido aten‐ dida en urgencias por una primera crisis convulsiva. La noche anterior, su madre escuchó un golpe y la encontró en el piso de su recámara con movimientos de sacudida, con los ojos abiertos y desviados hacia arriba. El episo‐ dio duró unos 2 minutos, y después la niña se quedó dormida. La madre llamó al número de emergencias en cuanto terminaron las sacudidas. A su llegada a urgencias, la exploración física y los estudios de laboratorio fue‐ ron normales, incluidos biometría hemática, glucosa capilar, química sanguínea completa con electrolitos y perfil toxicológico en suero y orina. Fue egresada tras varias horas de observación. En el consultorio, la niña y su ma‐ dre niegan episodios paroxísticos previos, antecedentes familiares de crisis convulsivas o epilepsia y cambios re‐ cientes de medicamentos. La niña niega consumo de drogas o alcohol. La exploración física, incluidos los signos vitales, y la exploración neurológica son normales. De los siguientes, el MEJOR siguiente paso en la evaluación diagnóstica de esta niña sería", "options": ["tomografía computarizada de cráneo", "electroencefalograma", "electrocardiograma", "resonancia magnética de encéfalo"]}, "8": {"stem": "Una adolescente de 16 años es llevada al servicio de urgencias por fatiga progresiva. Forma parte del equipo re‐ presentativo de futbol de su escuela y se encontraba en su estado de salud habitual hasta hace 2 días, cuando presentó intolerancia progresiva al ejercicio. En las últimas 48 horas su estado ha empeorado. Refiere palpitacio‐ nes y que le falta el aire después de subir un tramo de escaleras. Su crecimiento y desarrollo han sido normales y no tiene antecedentes médicos ni quirúrgicos relevantes. Tiene una temperatura de 37.8 °C, frecuencia cardiaca de 132 latidos/min, frecuencia respiratoria de 26 respiraciones/min, presión arterial de 98/70 mm Hg y saturación de oxígeno de 97% al aire ambiente. Su talla está en el percentil 60 y su peso en el percentil 40 para la edad. Las conjuntivas están pálidas y ligeramente ictéricas. Los campos pulmonares están limpios y el ritmo cardiaco es re‐ gular, con taquicardia. La punta del bazo se palpa justo por debajo del reborde costal. Se muestran los resultados de laboratorio: Prueba Resultado Leucocitos 9,900/µL (9.9 × 109/L) Hemoglobina 4.1 g/dL (41 g/L) Plaquetas 432 × 103/µL (432 × 109/L) Reticulocitos 13.1% Neutrófilos 45% Linfocitos 38% Monocitos 11% Eritrocitos nucleados Presentes Deshidrogenasa láctica 430 U/L (referencia, 135-225 U/L) Bilirrubina total 3.2 mg/dL (54.7 µmol/L) Prueba de antiglobulina directa (Coombs directo) Positiva para IgG De las siguientes, la conducta MÁS adecuada a continuación es administrar de manera urgente", "options": ["metilprednisolona 2 mg/kg por vía intravenosa", "solución salina al 0.9%, 20 mL/kg por vía intravenosa", "rasburicasa 0.2 mg/kg por vía intravenosa", "concentrado eritrocitario O negativo, 15 mL/kg"]}, "9": {"stem": "Un adolescente de 16 años, previamente sano, es valorado en urgencias por dolor punzante en el testículo iz‐ quierdo de 3 horas de evolución, que se irradia a la parte baja del abdomen. El dolor comenzó de forma súbita mientras jugaba videojuegos en su casa. No hubo traumatismo previo y no ha iniciado vida sexual. No tiene fie‐ bre, síntomas urinarios ni secreción uretral. Ha vomitado 2 veces desde que inició el dolor. En la exploración fí‐ sica, el hemiescroto izquierdo está edematoso y es muy doloroso a la palpación. El testículo izquierdo se observa elevado y con orientación horizontal. El reflejo cremastérico izquierdo está ausente. La exploración del hemies‐ croto derecho es normal. De los siguientes, el paso MÁS adecuado a continuación es", "options": ["incisión y drenaje", "ultrasonido escrotal", "pruebas en orina para gonorrea y clamidia", "interconsulta a urología"]}, "10": {"stem": "Un niño de 5 años, previamente sano, es llevado al servicio de urgencias tras 7 días de fiebre y fatiga. No ha te‐ nido tos, congestión nasal, rinorrea, vómito ni diarrea. Se ve enfermo, pero sin dificultad respiratoria. Tiene una temperatura de 39 °C, frecuencia cardiaca de 140 latidos/min, presión arterial de 90/60 mm Hg, frecuencia respi‐ ratoria de 40 respiraciones/min y saturación de oxígeno de 95%. Los ruidos respiratorios son claros en ambos he‐ mitórax. El ritmo cardiaco es regular. Se ausculta un soplo diastólico grado 2/4 que no estaba registrado en notas clínicas previas. Presenta petequias en la parte distal de las extremidades. Se toman hemocultivos y se realiza un ecocardiograma, en el que se observa una vegetación en la válvula mitral. De los siguientes, el patógeno que con MAYOR probabilidad causa la infección de este niño es", "options": ["Eikenella corrodens", "Kingella kingae", "Staphylococcus aureus", "Streptococcus pneumoniae"]}, "11": {"stem": "Un niño de 12 años con distrofia miotónica requiere apoyo ventilatorio nocturno a través de traqueostomía. Se ali‐ menta por vía oral, con complemento por gastrostomía. Ha tenido episodios intermitentes de fiebre asociados con aumento de las secreciones traqueales. Un estudio de deglución con bario modificado (videofluoroscopia) mues‐ tra disfagia orofaríngea: los líquidos claros penetran hasta las cuerdas vocales, pero los semisólidos no. De las siguientes, la medida MÁS adecuada a continuación para este niño es", "options": ["limitar la ingesta oral a sólidos y semisólidos", "manipulación farmacológica de las secreciones orales", "colocación de una cánula de traqueostomía con globo", "uso de una válvula de fonación Passy-Muir"]}, "12": {"stem": "Un lactante de 4 meses es valorado por lagrimeo excesivo y parpadeo desde el nacimiento. Sus padres refieren que le limpian secreción clara de los ojos y de la nariz varias veces al día. Parpadea con frecuencia y prefiere mantener los ojos cerrados cuando se expone a luz brillante. No ha tenido fiebre, enrojecimiento ni edema de los ojos, secreción amarillenta ni tos. Está afebril y se encuentra en el percentil 50 de peso y talla. En la exploración oftalmológica no fija la mirada ni sigue objetos. No hay edema ni eritema periorbitarios, y las conjuntivas y escle‐ ras están limpias. Presenta secreción clara bilateral, reflejo rojo opaco y leve opacidad corneal. De los siguientes, el diagnóstico MÁS probable en este lactante es", "options": ["dacriocistitis aguda", "catarata", "glaucoma", "obstrucción del conducto nasolagrimal"]}, "13": {"stem": "Un lactante de 2 meses acude a su consulta de control del niño sano. Sigue objetos con la mirada, tiene sonrisa social y sostiene la cabeza sin apoyo durante unos segundos. Tiene una hermana de 4 años con desarrollo nor‐ mal. El hermano de su madre falleció a los 20 años por complicaciones de una enfermedad muscular; tenía hiper‐ trofia de pantorrillas y usaba las manos para “trepar” sobre sí mismo al pasar de acostado a de pie. Requirió silla de ruedas desde los 10 años. La madre refiere no tener debilidad ni calambres musculares. Hace 5 años se le realizó un ecocardiograma por dolor torácico, que mostró una miocardiopatía dilatada leve que se consideró rela‐ cionada con el trastorno de su hermano. Los padres están preocupados por el riesgo de que su hijo tenga la misma enfermedad. De los siguientes, el porcentaje MÁS preciso de probabilidad de que este lactante tenga la misma enfermedad que su tío es", "options": ["25%", "50%", "75%", "100%"]}, "14": {"stem": "Un niño de 5 años es llevado al consultorio por su madre, quien está preocupada porque su hijo se golpea la ca‐ beza de manera intencional. Cuando ve videos, puede golpearse la cabeza varias veces contra el respaldo de su silla. Se golpea la cabeza contra la pared cuando no quiere hacer algo o cuando está molesto. A la hora de dor‐ mir, se golpea la cabeza contra la almohada hasta quedarse dormido. A la madre le preocupa que tenga dolores de cabeza o que pueda lesionarse gravemente. De los siguientes, el paso MÁS adecuado a continuación es", "options": ["terapia de análisis conductual aplicado", "resonancia magnética de encéfalo", "tranquilizar a la madre explicándole que estas conductas se resolverán con el tiempo", "tamiz para detectar una discapacidad del desarrollo"]}, "15": {"stem": "Se realiza un estudio prospectivo, aleatorizado y controlado para evaluar si los pacientes con bronquiolitis se be‐ nefician de nebulizaciones con solución salina hipertónica administradas en casa. Una cohorte de 600 pacientes con diagnóstico de bronquiolitis se asigna al azar a 3 grupos: sin tratamiento, tratamiento una vez al día o trata‐ miento 3 veces al día. Los síntomas se analizan diariamente durante 7 días mediante una lista de verificación de síntomas. De los 600 pacientes incluidos, 510 completaron adecuadamente las 7 listas diarias. Existe preocupa‐ ción sobre cómo podría influir esto en los resultados del estudio. De las siguientes, la MEJOR manera de mantener el poder estadístico del estudio y evitar el sesgo por apego es", "options": ["disminuir la duración del estudio", "aumentar el número de participantes", "utilizar un análisis por intención de tratar", "utilizar un análisis por protocolo"]}, "16": {"stem": "Una recién nacida de 3 días es llevada al servicio de urgencias por sangrado del muñón umbilical. La madre tuvo un embarazo sin complicaciones y un parto a término planeado en casa. Refiere que el ombligo comenzó a san‐ grar hace 12 horas y que ha sangrado continuamente a pesar de la presión aplicada con una toalla limpia. No hay antecedentes familiares de diátesis hemorrágica. La neonata llora vigorosamente y se ve pálida. Pesa 3.4 kg y tiene temperatura de 37 °C, frecuencia cardiaca de 178 latidos/min, frecuencia respiratoria de 28 respiraciones/min, presión arterial de 66/42 mm Hg y saturación de oxígeno de 95% al aire ambiente. Los campos pulmonares están limpios y el ritmo cardiaco es regular, aunque con taquicardia. No hay hepatomegalia ni esple‐ nomegalia. Se observa un goteo constante de sangre fresca proveniente del ombligo. No hay otros datos de san‐ grado. Se muestran los resultados de laboratorio: Prueba Resultado Leucocitos 11,400/µL (11.4 × 109/L) Hemoglobina 11.2 g/dL (112 g/L) Plaquetas 134 × 103/µL (134 × 109/L) Neutrófilos 53% Linfocitos 42% Monocitos 5% Tiempo de protrombina 25.2 s Tiempo de tromboplastina parcial 62 s De las siguientes, la condición que con MAYOR probabilidad contribuye a la presentación de esta paciente es", "options": ["coagulación intravascular diseminada", "deficiencia hereditaria del factor IX", "anticuerpos antiplaquetarios de origen materno", "una deficiencia vitamínica"]}, "17": {"stem": "Una adolescente de 15 años es valorada por caída de cabello. Notó la caída hace varios meses; en ese mo‐ mento, el área le daba un poco de comezón, era sensible y de color rosado. No tiene antecedentes personales ni familiares relevantes ni otros signos o síntomas. Está afebril y con signos vitales normales para la edad. Su cuero cabelludo se muestra en la Figura 17. El resto de la exploración física es normal, incluidos arcos de movilidad completos en todas las articulaciones, sin derrame articular, y sin otras lesiones cutáneas. Figura 17. Lesión del cuero cabelludo. Reproducida con autorización de Mancini AJ, Krowchuk DP, eds. Pediatric Dermatology: A Quick Reference Guide. 3rd ed. Elk Grove Village, IL: American Academy of Pediatrics; 2016. De los siguientes, el diagnóstico MÁS probable es", "options": ["alopecia areata", "esclerodermia lineal", "tiña de la cabeza", "tricotilomanía"]}, "18": {"stem": "Una niña de 11 años egresa del hospital con una receta de levetiracetam tras haber sido hospitalizada por epilep‐ sia generalizada de diagnóstico reciente. Dos semanas después regresa al servicio de urgencias con ideación suicida y agitación, y es ingresada a la unidad de psiquiatría infantil. Al realizar la conciliación de medicamentos se descubre que está tomando 4 veces la dosis indicada de levetiracetam. La investigación muestra que un mé‐ dico residente escribió de forma incorrecta la receta de egreso. Se contacta a su neurólogo y se confirma la dosis correcta. Se administra la dosis correcta en el hospital y los síntomas psiquiátricos se resuelven. De las siguientes, la persona MÁS adecuada para informar el error a la familia sería", "options": ["el psiquiatra infantil", "el supervisor de gestión de riesgos del hospital", "el médico residente que hizo la prescripción", "el neurólogo adscrito que supervisaba al residente"]}, "19": {"stem": "Un recién nacido de 37 semanas de gestación nace por preeclampsia materna. La madre tiene antecedentes de obesidad e hipertensión crónica. El neonato pesa 2.2 kg al nacer. A las 18 horas de vida, poco después de recibir seno materno complementado con fórmula, su glucosa capilar es de 35 mg/dL (1.9 mmol/L). Respira sin dificultad al aire ambiente y tiene buena perfusión. De las siguientes, la explicación MÁS probable de la cifra de glucosa de este neonato es", "options": ["hiperinsulinismo congénito", "disminución de las reservas de glucógeno", "hiperglucemia materna", "hipoglucemia fisiológica"]}, "20": {"stem": "Un niño de 3 años es valorado por el otorrinolaringólogo por disfonía progresiva en los últimos meses. Al llorar, su voz es débil y presenta dificultad respiratoria. Tiene tos intermitente, sin fiebre, rinorrea, congestión nasal, vómito ni dolor abdominal. Nació a término por parto vaginal y no tiene enfermedades crónicas. Sus signos vitales son: temperatura de 37 °C, frecuencia cardiaca de 115 latidos/min, frecuencia respiratoria de 30 respiraciones/min y presión arterial de 95/52 mm Hg. En la exploración física presenta estridor moderado. Se realiza una nasofaringo‐ laringoscopia (Figura 20). Figura 20. Hallazgos del niño descrito en el caso. Reproducida con autorización de Kimberlin DW, et al, eds. Red Book Online. Itasca, IL: American Academy of Pediatrics; 2018. De las siguientes, la causa MÁS probable de los síntomas de este niño es", "options": ["membrana laríngea", "papilomatosis respiratoria", "hemangioma subglótico", "nódulo de cuerda vocal"]}, "21": {"stem": "Una adolescente de 15 años acude a su consulta de control. Es bailarina de competencia: practica ballet, tap, danza moderna y lírica, con clases y ensayos todo el año, de 12 a 18 horas por semana. En los últimos 2 años ha tenido fracturas por estrés en el pie y en la pierna, que consolidaron tras un periodo adecuado de reposo y una re‐ incorporación progresiva a la actividad. Actualmente no tiene síntomas. Por lo demás, está sana. Su talla, peso e índice de masa corporal se han mantenido en el percentil 50, sin cambios recientes. Sus menstruaciones son re‐ gulares. No sigue restricciones alimentarias. La exploración física es normal; la marcha, la fuerza y los arcos de movilidad son normales. La adolescente pregunta cómo puede reducir el riesgo de sufrir otra lesión este año. De los siguientes, el estudio que con MAYOR probabilidad aportará información útil para atender la inquietud de esta adolescente es", "options": ["radiografías del pie y de la pierna", "resonancia magnética", "calcio sérico", "25-hidroxivitamina D total sérica"]}, "22": {"stem": "Un lactante de 2 meses acude a consulta por enfermedad. Su madre está preocupada porque respira rápido y come menos. En los últimos días, al alimentarse del seno materno, se cansa antes, respira un poco más rápido y suda. Ahora parece respirar más rápido incluso en reposo, cuando no está comiendo. No tiene rinorrea, tos, con‐ gestión nasal, fiebre, vómito, diarrea ni exantema. Está afebril. Tiene una frecuencia cardiaca de 158 latidos/min, presión arterial de 75/45 mm Hg y frecuencia respiratoria de 60 respiraciones/min. Se ve tranquilo. Su saturación de oxígeno es de 95%. Su peso se mantiene en el percentil 50 para la edad. El ritmo cardiaco es regular, con pri‐ mer ruido normal y desdoblamiento fisiológico del segundo ruido. Se ausculta un soplo holosistólico grado 2/6 en el borde esternal izquierdo inferior. Tiene buena perfusión y pulsos normales. El borde hepático se palpa 3 cm por debajo del reborde costal derecho. De los siguientes, el MEJOR paso (o pasos) en el tratamiento es (son)", "options": ["hospitalizar al lactante para evaluación de sepsis", "aumentar la densidad calórica de su alimentación y referirlo a cardiología pediátrica", "indicar furosemida y referirlo a cardiología pediátrica", "tranquilizar a la madre y citarlo en 2 semanas para control de peso"]}, "23": {"stem": "Una adolescente de 13 años es llevada al consultorio por su madre, quien está preocupada porque la menstrua‐ ción de su hija ha durado 2 semanas. Usa de 5 a 6 toallas sanitarias nocturnas al día y en ocasiones las traspasa en la escuela. Su menarca fue a los 12 años; tuvo 2 menstruaciones regulares y después no sangró durante 5 meses. No refiere fatiga, cefalea, palpitaciones ni mareo. No tiene antecedentes médicos relevantes, salvo epista‐ xis asociada con alergias estacionales en primavera y verano. Tiene una temperatura de 37.1 °C, frecuencia car‐ diaca de 96 latidos/min y presión arterial de 110/76 mm Hg. Se encuentra en el percentil 50 de talla y peso. En la exploración física destaca palidez conjuntival. Los campos pulmonares están limpios. En la exploración cardiaca hay taquicardia, sin soplos ni galope. No hay hepatoesplenomegalia, petequias ni otras lesiones cutáneas. De las siguientes, la prueba inicial MÁS adecuada para determinar la causa de los síntomas de esta paciente es", "options": ["biometría hemática completa con diferencial", "hormona estimulante de la tiroides (TSH)", "prueba de embarazo en orina", "panel para enfermedad de von Willebrand"]}, "24": {"stem": "Una niña de 5 años es valorada en urgencias por debilidad de inicio agudo en el brazo izquierdo. Dos semanas antes tuvo un cuadro viral inespecífico que se resolvió solo. El día del ingreso despertó sin poder mover el brazo izquierdo. Niega dolor, entumecimiento, cefalea, alteraciones de esfínteres o traumatismo previo. En urgencias está alerta, amable e interactiva, sin datos de encefalopatía. Sus signos vitales y la exploración física general son normales. En la exploración neurológica, los nervios craneales, el fondo de ojo, la sensibilidad y la marcha son normales. En la exploración motora destaca parálisis flácida de la extremidad superior izquierda con arreflexia; la fuerza, los reflejos y la coordinación están conservados en las demás extremidades. La resonancia magnética (RM) de encéfalo es normal. Se muestran las imágenes de RM de columna (Figuras 24A y 24B). La punción lum‐ bar muestra líquido cefalorraquídeo claro con pleocitosis linfocítica. Se envía líquido cefalorraquídeo para estu‐ dios virales y cultivo bacteriano. Figura 24A. Imagen axial en T2 de la columna torácica. Cortesía de Figura 24B. Imagen sagital STIR de la columna. Cortesía de J J Goldstein. Goldstein. De los siguientes, el diagnóstico MÁS probable en esta niña es", "options": ["mielitis flácida aguda", "encefalomielitis aguda diseminada", "síndrome de Guillain-Barré", "mielitis transversa idiopática"]}, "25": {"stem": "Un adolescente de 16 años con leucemia mieloide aguda diagnosticada hace 8 semanas permanece hospitali‐ zado por fiebre y neutropenia desde su último ciclo de quimioterapia. Ha tenido fiebre y neutropenia persistentes durante los últimos 5 días a pesar del tratamiento con antibióticos de amplio espectro, incluidos vancomicina y ceftazidima. Está febril, con frecuencia cardiaca de 110 latidos/min, frecuencia respiratoria de 24 respiraciones/min, presión arterial de 110/86 mm Hg y saturación de oxígeno de 92% al aire ambiente. Presenta disminución de los ruidos respiratorios y matidez a la percusión en la base pulmonar derecha y en la región axilar derecha. En los estudios de laboratorio destacan una cuenta absoluta de neutrófilos de 200/µL (0.2 × 109/L), anemia y trombocitopenia. Los hemocultivos se han mantenido negativos. La radiografía de tórax y la tomografía computarizada con contraste (Figura 25) muestran múltiples densidades nodulares de diversos tamaños en am‐ bos campos pulmonares. Figura 25. Tomografía computarizada del adolescente descrito en el caso. Cortesía de J Fish. De los siguientes, el microorganismo que con MAYOR probabilidad es responsable de los hallazgos del paciente es", "options": ["Aspergillus", "Mycoplasma", "Pneumocystis jirovecii", "Staphylococcus aureus"]}, "26": {"stem": "Un niño de 8 años acude a su consulta de control. Cursa el tercer grado de primaria en un grupo de educación es‐ pecial. Sus padres refieren que caminó a los 2 años, empezó a unir 2 palabras a los 3 años y ha recibido terapia física, ocupacional y de lenguaje toda su vida. En sus antecedentes perinatales y posnatales destacan hipotonía y falla de medro, y requirió una sonda de gastrostomía para alimentarse. Actualmente, a los padres les preocupa que come en exceso. Su peso está en el percentil 98 y su talla en el percentil 2. Tiene ojos almendrados, labio su‐ perior delgado, manos y pies pequeños, y pene pequeño con escroto hipoplásico. El resto de la exploración física es normal. De las siguientes, la terapia MÁS adecuada para esta condición es", "options": ["glucocorticoides en el primer año de vida junto con manejo nutricional", "hormona de crecimiento en el primer año de vida junto con manejo nutricional", "hormona de crecimiento en el primer año de vida con suplementación de carnitina", "levotiroxina en el primer año de vida junto con manejo nutricional"]}, "27": {"stem": "Una lactante de 9 meses es llevada a consulta para valoración urgente. Sus padres refieren que está somno‐ lienta, débil y decaída. Ayer comenzó con rinorrea y aumento de la salivación. Hoy ha tenido 5 evacuaciones dis‐ minuidas de consistencia y ha disminuido su ingesta oral. Ha mojado un número normal de pañales. Vive con sus padres en un rancho agrícola. No ha tenido contacto con enfermos y no acude a guardería. Tiene una tempera‐ tura de 37.5 °C, frecuencia cardiaca de 80 latidos/min, frecuencia respiratoria de 50 respiraciones/min y presión arterial de 90/50 mm Hg. Presenta hipotonía y somnolencia, pero responde adecuadamente a estímulos doloro‐ sos. Sus pupilas están contraídas (1 a 2 mm de diámetro) y presenta lagrimeo y sialorrea. Los campos pulmona‐ res están limpios a la auscultación. Se observan retracciones intercostales intermitentes. El ritmo cardiaco es re‐ gular, y el abdomen es blando y no doloroso, sin distensión ni hepatoesplenomegalia. La piel está seca y el lle‐ nado capilar es de 3 segundos. De las siguientes, la fuente MÁS probable del tóxico que causa sus síntomas es", "options": ["el excremento de gallina", "la leche de cabra", "la ropa de los padres", "la miel sin pasteurizar"]}, "28": {"stem": "Una niña de 3 años es llevada a consulta por sangrado rectal. Los síntomas comenzaron hace aproximadamente 6 meses: sus padres notaban de forma intermitente sangre roja brillante en el papel higiénico y en el inodoro; sin embargo, en las últimas semanas el sangrado ha aumentado y ahora presenta sangre en cada evacuación. No tiene antecedentes de estreñimiento y evacúa heces blandas 1 a 2 veces al día. Ya controla esfínteres y no pa‐ rece tener evacuaciones dolorosas. Por lo demás está sana, con crecimiento y desarrollo excelentes. En la explo‐ ración física, los signos vitales son normales; el abdomen es blando y no doloroso, sin masas ni hepatoespleno‐ megalia; el tacto rectal es normal y no hay sangre macroscópica. El gammagrama para divertículo de Meckel es negativo. Se muestran los resultados de laboratorio: Prueba Resultado Sangre oculta en heces Positiva Leucocitos 9,000/µL (9.0 × 109/L) Hemoglobina 11.8 g/dL (118 g/L) Hematocrito 32.8% Plaquetas 310 × 103/µL (310 × 109/L) Velocidad de sedimentación globular 3 mm/h De las siguientes, la causa MÁS probable de los hallazgos de esta niña es", "options": ["alergia a la proteína de la leche de vaca", "colitis infecciosa", "pólipo juvenil", "enfermedad inflamatoria intestinal de inicio muy temprano"]}, "29": {"stem": "Una niña de 5 años con esquema de vacunación completo es valorada por una herida punzante en la planta del pie derecho. Caminaba con sus padres cuando de repente cayó al suelo llorando. Cuando su padre la levantó, notó un clavo que sobresalía de la suela de su tenis. Le retiró el clavo y la llevó al servicio de urgencias. En la ex‐ ploración física hay una herida punzante única en la planta del pie derecho, de la que sale un poco de sangre. La piel circundante está íntegra, con eritema y dolor mínimos. La niña tiene arcos de movilidad completos e indoloros del tobillo y de los dedos. El padre entrega el clavo oxidado, completo, para su inspección. De los siguientes, el paso MÁS adecuado a continuación en el manejo de esta niña es", "options": ["irrigación de la herida", "administración de antibiótico por vía oral", "profilaxis antitetánica posexposición", "desbridamiento de la herida"]}, "30": {"stem": "Una adolescente sana de 16 años acude a su consulta de control. Su madre no refiere preocupaciones. Los sig‐ nos vitales, los parámetros de crecimiento y la exploración física son normales. Su desarrollo puberal corresponde a Tanner IV; su menarca fue a los 12 años. La madre refiere que su religión prohíbe recibir vacunas después de la menarca. En privado, la adolescente comenta que ha investigado por su cuenta sobre las vacunas y solicita que se le apliquen todas las vacunas recomendadas. De los siguientes, el MEJOR paso a continuación es", "options": ["aplicar todas las vacunas recomendadas de forma confidencial", "contactar al comité de ética local para recibir apoyo", "explorar con mayor profundidad la decisión de la madre respecto a la vacunación", "reportar a la madre a los servicios de protección infantil por negligencia"]}, "31": {"stem": "Un niño de 9 años acude a seguimiento de rutina por asma diagnosticada a los 3 años. Desde el diagnóstico ha recibido corticosteroides inhalados. Sus medicamentos actuales son furoato de mometasona 100 µg con fumarato de formoterol 5 µg, 2 inhalaciones dos veces al día; propionato de fluticasona, una aplicación en cada narina al día; y salbutamol, 2 disparos inhalados cada 4 horas en caso necesario por tos, falta de aire o sibilancias. Su asma ha estado bien controlada desde que se intensificó el tratamiento con corticosteroide inhalado hace 3 años. Su última crisis asmática y su último ciclo de corticosteroide oral fueron hace más de 1 año. Sus signos vitales son normales para la edad. Su curva de crecimiento se muestra en la Figura 31. Su índice de masa corporal es de 15.9 kg/m2 (percentil 40). La exploración del aparato respiratorio es normal. El resto de la exploración física no muestra alteraciones. Figura 31. Curva de crecimiento del niño descrito en el caso. De las siguientes, la causa MÁS probable de los hallazgos físicos de este niño es", "options": ["retraso constitucional del crecimiento", "glucocorticoide exógeno", "deficiencia de hormona de crecimiento", "adenoma hipofisario"]}, "32": {"stem": "Una niña de 7 años es valorada por un exantema pruriginoso de 3 días de evolución. Por lo demás se encuentra bien, no toma medicamentos y no ha tenido erupciones similares. Sus signos vitales son normales y la explora‐ ción física no muestra alteraciones, salvo un exantema con distribución en placas en la cara y las extremidades superiores (Figura 32). Figura 32. Exantema de la niña descrita en el caso. Reproducida con autorización de Krowchuk D. Miscellaneous Skin Conditions. En: Neinstein LS, Katzman DK, Callahan T, Gordon CM, Joffe A, Rickert V, eds. Neinstein's Adolescent and Young Adult Health Care. 6th ed. Wolters Kluwer; 2016. De los siguientes, el diagnóstico MÁS probable es", "options": ["dermatitis por contacto alérgica", "dermatitis atópica", "dermatitis por contacto irritativa", "dermatitis seborreica"]}, "33": {"stem": "Un adolescente de 14 años que inmigró recientemente desde El Salvador es atendido en la consulta pediátrica por un exantema. Estaba sano hasta hace 3 días, cuando presentó malestar general y dolor de garganta. Ayer notó un exantema pruriginoso y doloroso en el tórax que ha progresado. No tiene enfermedades crónicas. Se des‐ conocen sus antecedentes de vacunación. En la exploración física tiene temperatura de 37.9 °C, frecuencia car‐ diaca de 98 latidos/min, frecuencia respiratoria de 16 respiraciones/min y presión arterial de 128/65 mm Hg. Se observan múltiples lesiones papulares a vesiculares en la cara, el tórax y las extremidades (Figura 33). El adoles‐ cente permaneció 20 minutos en la sala de espera antes de pasar a un consultorio. Al mismo tiempo, en la sala de espera había otro niño, un lactante sano de 6 meses. Figura 33. Lesiones del adolescente descrito en el caso. Cortesía de L Marquez. De las siguientes, la conducta MÁS adecuada respecto a la exposición de este lactante es", "options": ["inmunoglobulina específica contra la enfermedad", "vacunación específica contra la enfermedad", "ninguna profilaxis", "aciclovir oral"]}, "34": {"stem": "Una adolescente de 15 años es llevada a urgencias por una primera crisis tónico-clónica generalizada que ocurrió mientras dormía. Estaba en una pijamada y se desveló hasta las 3 de la mañana. Alrededor de las 7, su amiga la encontró sin responder, con sacudidas generalizadas, los ojos abiertos y desviados hacia arriba, y espuma en la boca. El episodio duró unos 2 minutos y cedió solo. A su llegada a urgencias está somnolienta, pero despierta con estímulos. El resto de la exploración neurológica es normal. Su madre refiere que en los últimos años ha tenido varios episodios de “mirada perdida”, que atribuía a que su hija la ignoraba. Durante el último año se ha quejado periódicamente de “espasmos”, en los que su mano salta o se sacude de repente. Niega consumo de sustancias, enfermedades recientes o intercurrentes y traumatismos. No hay antecedentes familiares de crisis convulsivas. De los siguientes, el diagnóstico MÁS probable es", "options": ["epilepsia focal benigna de la infancia", "epilepsia de ausencia juvenil", "epilepsia mioclónica juvenil", "epilepsia mioclónica progresiva"]}, "35": {"stem": "Un niño de 11 años ingresa a la Unidad de Terapia Intensiva Pediátrica con lesión cerebral hipóxica grave tras un ahorcamiento autoinfligido. Inicialmente recibe tratamiento conservador de neuroprotección. Después de 72 horas de atención, la exploración neurológica muestra apnea con el ventilador, postura de decorticación ante estímulos dolorosos (que, mediante electroencefalografía, se determina que no es un reflejo espinal), pupilas fijas y dilata‐ das, y diabetes insípida. Tras una reunión con la familia para comentar el estado actual del niño, la madre pre‐ gunta si su hijo podría ser donador de órganos. De las siguientes, la MEJOR respuesta para la madre es que el niño", "options": ["tiene muerte encefálica, por lo que la donación de órganos es una opción y debe procederse con la interconsulta a la coordinación de donación, como se solicitó", "no es candidato a donación de órganos porque no dio su asentimiento previo", "no es candidato a donación de órganos porque el mecanismo de la lesión fue un intento de suicidio", "sería candidato a donación tras muerte cardiaca"]}, "36": {"stem": "Un médico realiza una consulta de seguimiento a una niña de 12 años que presenta vómitos sin dolor. Tiene 6 meses con regurgitación sin esfuerzo, no sanguinolenta y no biliosa, que ocurre 30 minutos después de las comi‐ das al menos una vez al día. Ha perdido 4 kg en los últimos 6 meses. Refiere que disfruta la comida y que no in‐ tenta bajar de peso. No refiere náusea, dolor abdominal, distensión, diarrea ni estreñimiento. Recibió un inhibidor de la bomba de protones durante 6 semanas, sin mejoría. En la exploración física, la frecuencia cardiaca está dentro de lo normal y la dentadura es normal. De los siguientes, el diagnóstico MÁS probable es", "options": ["síndrome de vómito cíclico", "trastorno de la conducta alimentaria", "gastritis por Helicobacter pylori", "síndrome de rumiación"]}, "37": {"stem": "Un niño de 4 años (Figura 37) acude a su consulta de control del niño sano. Nació a término; su madre tenía 35 años. La madre refiere que a los 30 años recibió tratamientos de fertilidad por insuficiencia ovárica prematura. El niño tiene retraso del lenguaje y solo dice 10 palabras. Es muy activo y corre por el consultorio durante toda la consulta. A la madre le preocupan su conducta, sus frecuentes berrinches, el aleteo de manos y que muerde a su hermana de 2 años. En los antecedentes familiares destacan trastorno bipolar en la abuela materna y enfermedad de Parkinson en el abuelo materno. Se desconocen los antecedentes familiares paternos. Figura 37. Niño descrito en el caso. Reproducida con autorización de Saul RA, ed. Medical Genetics in Pediatric Practice. Elk Grove Village, IL: American Academy of Pediatrics; 2013. De las siguientes, la causa subyacente MÁS probable del trastorno clínico de este niño es", "options": ["repeticiones CAG en HTT", "repeticiones CGG en FMR1", "repeticiones CTG en DMPK", "repeticiones GAA en FXN"]}, "38": {"stem": "Un recién nacido de 2 días es trasladado a la UCIN tras presentar petequias. Nació por parto vaginal a término después de un embarazo sin complicaciones. Su madre tuvo hemorragia posparto, y en los estudios realizados en ese momento se encontró una cuenta de plaquetas de 15 × 103/µL (15 × 109/L). Un mes antes, su biometría hemática había sido normal. Se muestran los resultados de laboratorio del recién nacido: Prueba Resultado Leucocitos 12,500/µL (12.5 × 109/L) Hemoglobina 18.2 g/dL (182 g/L) Plaquetas 12 × 103/µL (12 × 109/L) De los siguientes, el paso MÁS adecuado a continuación en el tratamiento es administrar", "options": ["anticuerpo monoclonal anti-D", "inmunoglobulina intravenosa", "plaquetas maternas", "metilprednisolona"]}, "39": {"stem": "Una madre llama al pediatra para informar que su hija de 5 años le reveló anoche que su hermano de 12 años ha estado entrando a su recámara por las noches y pidiéndole que le toque sus “partes íntimas”. Cuando la madre lo interrogó, el niño negó que esto hubiera ocurrido. La madre planea dormir en la misma habitación que su hija hasta que se complete una evaluación. De los siguientes, además de programar una cita para esta niña, el paso MÁS adecuado a continuación es", "options": ["indicar a la madre que el hermano debe salir de inmediato de la casa para quedarse con familiares", "tranquilizar a la madre diciéndole que ha tomado todas las medidas necesarias para garantizar la seguridad de sus hijos", "reportar la situación a los servicios locales de protección infantil", "reportar la situación a la policía local"]}, "40": {"stem": "Un adolescente de 13 años es valorado después de recibir un golpe con una pelota de frontón (handball) en la re‐ gión orbitaria izquierda. De inmediato refirió dolor en el ojo izquierdo y náusea, y fue llevado al servicio de urgen‐ cias. En la exploración física hay edema y equimosis periorbitarios izquierdos leves, sin dolor óseo a la palpación. Las pupilas son isocóricas, redondas y reactivas a la luz, y los movimientos extraoculares están conservados. Las conjuntivas están limpias y la tinción con fluoresceína no muestra abrasiones corneales ni esclerales. La tonome‐ tría muestra presión intraocular normal; la agudeza visual es de 20/20 en ambos ojos. En la exploración con lám‐ para de hendidura se observa un hifema que ocupa menos de 25% de la cámara anterior (Figura 40). Figura 40. Hallazgos del adolescente descrito en el caso. Reproducida con autorización de Lavrich JB, Heersink S. Red Eye/Pink Eye. En: McInerny TK, Adam HM, Campbell DE, DeWitt TG, Foy JM, Kamat DM, eds. American Academy of Pediatrics Textbook of Pediatric Care. 2nd ed. Itasca, IL: American Academy of Pediatrics; 2016. De los siguientes, el MEJOR paso a continuación en el manejo de este adolescente es", "options": ["administración de oxígeno al 100%", "administración de activador tisular del plasminógeno por vía tópica", "colocación de un protector ocular", "colocación de la cama en posición de Trendelenburg"]}, "41": {"stem": "Un lactante varón de 2 meses, sano y nacido a término, acude a su consulta de control. La familia se mudó re‐ cientemente de otro estado. La madre refiere drenaje persistente de líquido claro por el ombligo, a pesar de varias cauterizaciones con nitrato de plata realizadas por su pediatra anterior. Por lo demás, el lactante está bien y se ha mantenido afebril. Su ingesta, sus micciones y sus evacuaciones son normales. Los signos vitales y los paráme‐ tros de crecimiento son normales. La exploración física es normal, salvo un granuloma umbilical de 3 mm de diá‐ metro con drenaje seroso. No hay eritema ni dolor alrededor del ombligo. De los siguientes, el MEJOR paso a continuación en el manejo es", "options": ["ligar el muñón umbilical con suturas absorbibles", "realizar un ultrasonido del ombligo", "indicar cefalexina por vía oral", "tranquilizar a los padres"]}, "42": {"stem": "Una recién nacida de 12 días es valorada en urgencias por fiebre. Ayer la notaron irritable y hoy tuvo una tempe‐ ratura de 39 °C y es difícil de consolar. No tiene otros síntomas. Nació a término por parto vaginal; su madre, de 34 años, tuvo un embarazo sin complicaciones. Sus signos vitales son: temperatura de 38.6 °C, frecuencia car‐ diaca de 180 latidos/min, frecuencia respiratoria de 50 respiraciones/min y presión arterial de 82/45 mm Hg. En la exploración física está irritable y la fontanela anterior está llena. Se toman muestras de sangre, orina y líquido ce‐ falorraquídeo para estudio microbiológico. La tinción de Gram del líquido cefalorraquídeo se muestra en la Figura 42. Figura 42. Tinción de Gram del líquido cefalorraquídeo. © Martha Lepow; reproducida con autorización de Kimberlin DW, et al, eds. Red Book Online. Itasca, IL: American Academy of Pediatrics; 2018. De los siguientes, el MEJOR tratamiento para esta infección es", "options": ["ampicilina", "azitromicina", "ceftazidima", "vancomicina"]}, "43": {"stem": "Un recién nacido varón de unas cuantas horas de vida es trasladado a la unidad de cuidados intermedios neona‐ tales porque la enfermera notó cianosis. La madre tuvo un control prenatal limitado, pero sus estudios prenatales fueron normales. El neonato está afebril. Tiene una frecuencia cardiaca de 160 latidos/min, presión arterial de 75/45 mm Hg en el miembro superior derecho y de 78/46 mm Hg en el miembro inferior derecho, frecuencia respi‐ ratoria de 60 respiraciones/min y saturación de oxígeno de 70%, que aumenta a 74% al agregar oxígeno suple‐ mentario. Respira sin dificultad y los ruidos respiratorios son claros. El ritmo cardiaco es regular, con primero y se‐ gundo ruidos normales y un soplo pansistólico grado 3/6 que se ausculta mejor en el borde esternal izquierdo in‐ ferior. Sus manos y pies están ligeramente fríos, pero por lo demás está caliente y bien perfundido. El hígado se palpa 2 a 3 cm por debajo del reborde costal. Se obtiene una radiografía de tórax (Figura 43). Figura 43. Radiografía del neonato descrito en el caso. Cortesía de M McBride. De los siguientes, el diagnóstico MÁS probable en este neonato es", "options": ["anomalía de Ebstein", "síndrome de corazón izquierdo hipoplásico", "tronco arterioso", "comunicación interventricular"]}, "45": {"stem": "Una niña de 2 años con retraso global del desarrollo leve y epilepsia refractaria inicia una dieta cetogénica para el control de sus crisis. Presenta mejor control de las crisis y es vigilada estrechamente por un epileptólogo pediatra y una nutrióloga. Su madre la lleva a su consulta de control y refiere que, en general, la niña tolera bien la dieta, con estreñimiento leve, y que toma diariamente un multivitamínico con suplementos de calcio y vitamina D. La madre comenta que sabe que la dieta puede tener otros efectos adversos y pregunta si debe vigilarse alguna otra complicación. De las siguientes, la niña tiene MAYOR riesgo de", "options": ["deficiencia de carnitina", "litiasis renal", "osteopenia", "deficiencia de zinc"]}, "46": {"stem": "Un niño de 6 años es evaluado por preocupaciones sobre su conducta. Tiene trastorno del espectro autista y re‐ cibe servicios de educación especial y terapia de análisis conductual aplicado en casa. A pesar de usar las estra‐ tegias aprendidas en la terapia, su madre refiere dificultad para manejar su conducta. Le preocupa su seguridad cuando están en lugares públicos, ya que a menudo sale corriendo y se aleja de ella. En las tiendas tira los artícu‐ los de los anaqueles. En la escuela le cuesta trabajo permanecer sentado y en varias ocasiones ha salido del sa‐ lón sin permiso. No es agresivo con otros ni presenta conductas autolesivas. El resto del interrogatorio por apara‐ tos y sistemas es negativo. El niño habla con oraciones cortas y completas y establece algo de contacto visual. Con estímulo, coopera con la exploración física, que es normal. De los siguientes, el MEJOR paso a continuación en el manejo de este niño es", "options": ["referirlo a terapia ocupacional", "prescribir un antipsicótico atípico", "solicitar un entorno educativo más restrictivo", "realizar tamizaje de una condición de salud mental coexistente"]}, "47": {"stem": "Una niña de 6 años es valorada por su pediatra después de no aprobar el tamiz visual escolar. Una evaluación posterior por oftalmología muestra ausencia de visión en el ojo derecho y atrofia bilateral del disco óptico. Se le refiere al servicio de urgencias. No tiene antecedentes médicos relevantes. Tiene buen aspecto y no presenta mo‐ lestias. Su talla está en el percentil 1 y su peso en el percentil 7. Una gráfica de crecimiento que trae su madre muestra que hace 1 año su talla estaba en el percentil 15. Tiene temperatura de 37.1 °C, frecuencia cardiaca de 92 latidos/min, presión arterial de 108/78 mm Hg, frecuencia respiratoria de 22 respiraciones/min y saturación de oxígeno de 98% al aire ambiente. Fuera de la ausencia completa de visión en el ojo derecho, la exploración física es normal. Se muestran los hallazgos de la resonancia magnética urgente (Figura 47). Figura 47. Resonancia magnética de la paciente descrita en el caso. Cortesía de J Fish. De los siguientes, el desenlace MÁS probable después del tratamiento inicial es", "options": ["panhipopituitarismo que requerirá reemplazo hormonal de por vida", "progresión a herniación e insuficiencia respiratoria", "pérdida progresiva de la visión que llevará gradualmente a la ceguera", "enfermedad recurrente y metastásica, refractaria al tratamiento"]}, "48": {"stem": "Una niña de 6 años es llevada a urgencias por 1 día de fiebre, claudicación y dolor en la extremidad inferior dere‐ cha. Hace 2 semanas tuvo una infección leve de vías respiratorias superiores. No ha tenido traumatismos recien‐ tes. Está alerta e interactiva y tiene una temperatura de 39.5 °C. Se encuentra acostada con la extremidad inferior derecha en abducción y rotación externa. En la exploración musculoesquelética presenta molestia con la rotación interna y externa de la cadera derecha. El resto de la exploración física es normal. En los estudios de laboratorio destacan una cuenta de leucocitos de 18,000/µL (18 × 109/L) con 70% de neutrófilos segmentados y una proteína C reactiva elevada. La radiografía simple de cadera derecha es normal y se toma un hemocultivo. De los siguientes, el MEJOR paso a continuación en el manejo es", "options": ["administrar ibuprofeno", "administrar clindamicina por vía intravenosa", "realizar ultrasonido de la cadera derecha", "programar valoración por ortopedia para el día siguiente"]}, "49": {"stem": "Un adolescente de 15 años, previamente sano, es llevado a urgencias directamente desde el entrenamiento de futbol americano porque refirió dolor en el cuadrante superior izquierdo del abdomen después de ser tacleado. No perdió el estado de alerta, no tiene cefalea y no ha vomitado. Tiene dolor en el hombro izquierdo que empeora con la inspiración. Sus signos vitales son: temperatura de 37.2 °C, frecuencia cardiaca de 100 latidos/min, fre‐ cuencia respiratoria de 20 respiraciones/min, presión arterial de 106/65 mm Hg y saturación de oxígeno de 100% al aire ambiente por oximetría de pulso. Se ve adolorido, pero está alerta y orientado. En la exploración destacan dolor a la palpación del cuadrante superior izquierdo y ligera distensión abdominal. Su piel está caliente y bien perfundida, y los arcos de movilidad de todas las extremidades son adecuados. Se colocan 2 accesos intraveno‐ sos de grueso calibre, y la radiografía de tórax es normal. De las siguientes, la MEJOR modalidad de imagen abdominal para confirmar el diagnóstico es", "options": ["tomografía computarizada", "resonancia magnética", "radiografía", "ultrasonido"]}, "50": {"stem": "Una lactante de 2 meses es llevada a consulta por ictericia que sus familiares notaron la semana pasada. Por lo demás ha estado bien, con crecimiento y desarrollo normales. Se alimenta exclusivamente con leche materna. Tiene varias evacuaciones al día, que sus padres describen de color verde y café. Nació a término tras un emba‐ razo y un parto sin complicaciones. Tuvo ictericia leve durante la primera semana de vida, que se resolvió sin foto‐ terapia. Su tamiz neonatal fue normal. En la exploración física pesa 4.4 kg (percentil 25), mide 55 cm (percentil 25) y su relación peso/longitud está en el percentil 40. Tiene ictericia escleral. El abdomen es blando y no disten‐ dido, con el borde hepático palpable 2 a 3 cm por debajo del reborde costal derecho. No hay esplenomegalia. El resto de la exploración física es normal. La Figura 50 muestra el aspecto de sus evacuaciones en el pañal. Figura 50. Evacuación en el pañal. Cortesía de J Sullivan. Se muestran los resultados de laboratorio: Prueba Resultado Alanina aminotransferasa 83 U/L Aspartato aminotransferasa 147 U/L γ-glutamiltransferasa 1,662 U/L Bilirrubina total 9.7 mg/dL (166 µmol/L) Bilirrubina directa 6.5 mg/dL (111 µmol/L) Leucocitos 12,200/µL (12.2 × 109/L) Hematocrito 36.4% Plaquetas 530 × 103/µL (530 × 109/L) Están pendientes el examen general de orina, el urocultivo y la búsqueda de citomegalovirus en orina. De los siguientes, el MEJOR estudio a realizar a continuación es", "options": ["ultrasonido abdominal", "biopsia hepática", "cortisol matutino", "cloro en sudor"]}, "51": {"stem": "Una lactante de 4 meses con 5 días de diarrea es llevada a urgencias. Desde hace 2 días rechaza la fórmula. No ha tenido vómito, fiebre ni distensión abdominal. Está somnolienta, pero al estimularla tiene un llanto agudo. Tiene frecuencia cardiaca de 160 latidos/min, frecuencia respiratoria de 22 respiraciones/min y presión arterial de 70/38 mm Hg. Su piel se siente pastosa. Las mucosas están secas. El resto de la exploración física no muestra altera‐ ciones. Se muestran los resultados de laboratorio: Prueba Resultado Sodio 162 mEq/L (162 mmol/L) Potasio 3.1 mEq/L (3.1 mmol/L) Cloro 115 mEq/L (115 mmol/L) Bicarbonato 18 mEq/L (18 mmol/L) Nitrógeno ureico en sangre 28 mg/dL (10.0 mmol/L) Creatinina 0.5 mg/dL (44 µmol/L) Glucosa 90 mg/dL (5.0 mmol/L) Osmolalidad sérica 340 mOsm/kg (340 mmol/kg) (referencia, 275-295 mOsm/kg) De las siguientes, la complicación MÁS probable de una corrección rápida del trastorno de esta lactante es", "options": ["mielinólisis pontina central", "edema cerebral", "trombosis de senos venosos durales", "hemorragia subdural"]}, "52": {"stem": "Se evalúa a un recién nacido de 25 horas de vida por distensión abdominal. Su madre, de 34 años, tiene diabetes gestacional controlada con dieta; su hemoglobina A1c es de 6.6%. En el ultrasonido prenatal se observó intestino ecogénico. Nació por parto vaginal, con Apgar de 9 al minuto y a los 5 minutos. Ha sido alimentado al seno ma‐ terno 6 veces, con buen agarre. Aún no ha evacuado. En la exploración física se ve tranquilo. Tiene un mechón de cabello blanco prominente, tórax en forma de barril, distensión abdominal moderada y ruidos intestinales dismi‐ nuidos (Figura 52A). Se realiza una radiografía de abdomen (Figura 52B). Figura 52A. Hallazgos del neonato descrito en el caso. Figura 52B. Radiografía de abdomen del neonato descrito en el Reproducida con autorización de Wong J. A male infant who has a caso. Cortesía de M LaTuga. white hair tuft. Pediatr Rev. 2012;33(3):e18. De los siguientes, el diagnóstico MÁS probable en este neonato es", "options": ["enfermedad de Hirschsprung", "ingesta oral insuficiente", "enterocolitis necrosante", "síndrome de colon izquierdo pequeño"]}, "53": {"stem": "Un niño de 4 años es llevado a consulta por una masa en el cuello. Hace 2 semanas tuvo fiebre de bajo grado, ri‐ norrea y tos, que ya se resolvieron. Desde entonces, su madre notó una “bolita” indolora en el centro del cuello. Sus signos vitales y parámetros de crecimiento son normales. Las membranas timpánicas, las fosas nasales y la orofaringe son normales. Presenta una masa de 3 cm en la línea media de la cara anterior del cuello, indolora, fluctuante y móvil (Figura 53), sin eritema ni secreción. La masa asciende al protruir la lengua y al deglutir. Figura 53. Masa en la línea media anterior del cuello del niño descrito en el caso. Reproducida con autorización de Doernbecher Children's Hospital, Portland, Oregon. De los siguientes, el MEJOR paso a continuación en el tratamiento es", "options": ["antibióticos empíricos", "aspiración con aguja fina", "determinación de hormona estimulante de la tiroides", "ultrasonido"]}, "54": {"stem": "Un niño de 4 años es valorado en urgencias 30 minutos después de que su madre lo vio tragarse algo brillante. Desde entonces se ha quejado de dolor abdominal, pero no presenta sialorrea. Tiene frecuencia cardiaca de 110 latidos/min, frecuencia respiratoria de 20 respiraciones/min y saturación de oxígeno por oximetría de pulso de 98% al aire ambiente. Está alerta e interactivo. Los ruidos respiratorios son normales, sin sibilancias ni estridor. Se obtiene una radiografía de tórax (Figura 54). Figura 54. Radiografía del niño descrito en el caso. Cortesía de J Reed. De los siguientes, el MEJOR paso a continuación en la atención de este niño es", "options": ["extracción endoscópica del objeto", "tranquilizar a la madre", "repetir la radiografía en 6 horas", "serie esofagogastroduodenal"]}, "55": {"stem": "Un recién nacido a término nace por parto vaginal precipitado de una mujer de 22 años que emigró recientemente de El Salvador y no recibió atención prenatal. La prueba rápida para el virus de la inmunodeficiencia humana y la prueba de reagina plasmática rápida realizadas a la madre poco después del parto son negativas. El neonato pesa 2.2 kg y tiene microcefalia. Está alerta, con llanto vigoroso y con tono y actividad normales. El reflejo rojo está disminuido en el ojo derecho y ausente en el izquierdo. Presenta hepatoesplenomegalia leve, petequias y un soplo sistólico expulsivo grado 2/6 en el borde esternal izquierdo superior. El resto de la exploración física no muestra alteraciones. En los estudios de laboratorio destaca trombocitopenia. Una tomografía computarizada de cráneo muestra calcificaciones. La evaluación audiológica muestra ausencia de potenciales evocados auditivos de tallo cerebral en ambos oídos. La serie ósea muestra bandas radiolúcidas transversales en las metáfisis proxi‐ males de ambos húmeros. La valoración oftalmológica muestra cataratas bilaterales. De las siguientes, la causa MÁS probable de los hallazgos de este neonato es", "options": ["citomegalovirus", "rubéola", "sífilis", "toxoplasma"]}, "56": {"stem": "Un niño de 8 años es llevado al consultorio por una masa en la ingle. Hace 3 días se le diagnosticó un absceso en la región glútea, que se drenó con éxito mediante incisión. Por lo demás ha estado bien, afebril y sin dolor. Sus signos vitales son normales. En la exploración física se observa una incisión en cicatrización en el glúteo iz‐ quierdo y un nódulo subcutáneo de 2 cm en la ingle izquierda, no doloroso, sin eritema, móvil y bien delimitado. De los siguientes, el MEJOR paso a continuación en el manejo es", "options": ["hospitalizarlo para antibióticos intravenosos", "solicitar una biometría hemática completa", "realizar un ultrasonido de la lesión", "tranquilizar a los padres"]}, "57": {"stem": "Un niño de 4 años es atendido en urgencias por 6 horas de inquietud progresiva, movimientos anormales de las extremidades, visión borrosa y sialorrea. Sus padres refieren que estaba sano hasta que sintió que algo punzante le tocó el dedo gordo del pie derecho al ponerse los zapatos. Le revisaron el dedo en ese momento, pero no vie‐ ron ninguna marca. En el transcurso de la siguiente hora se quejó de una “sensación rara” en la pierna derecha, y poco después comenzaron los demás síntomas. En la exploración física tiene temperatura de 38.2 °C, frecuencia cardiaca de 140 latidos/min, frecuencia respiratoria de 22 respiraciones/min, presión arterial de 110/60 mm Hg y saturación de oxígeno de 100% al aire ambiente. Está alerta y orientado, y responde preguntas de forma ade‐ cuada. Se ve incómodo y se retuerce de manera intermitente sobre la camilla. Las pupilas son isocóricas, redon‐ das y reactivas a la luz; sin embargo, tiene movimientos extraoculares anormales. Las mucosas están húmedas y la sialorrea es mínima. El ritmo cardiaco es normal, sin soplos; se auscultan sibilancias espiratorias aisladas, y la exploración abdominal es normal. En la piel no se encuentran marcas ni equimosis. La palpación del dedo gordo del pie derecho produce dolor intenso. De los siguientes, el animal que con MAYOR probabilidad causó los síntomas de este niño es", "options": ["Centruroides sculpturatus (alacrán de corteza de Arizona)", "Crotalus atrox (víbora de cascabel de diamantes del oeste)", "Latrodectus mactans (araña viuda negra)", "Vespula squamosa (avispa chaqueta amarilla del sur)"]}, "58": {"stem": "Una niña de 10 años con diabetes tipo 1 acude por disminución del apetito y fatiga en el último mes. Hace 3 comi‐ das al día, pero en porciones pequeñas por náusea. No ha tenido dolor abdominal, vómito, diarrea, estreñimiento ni enfermedades recientes. Su diabetes se trata con insulina de acción rápida mediante una bomba de insulina. Ha perdido 2.3 kg desde su última consulta de control, hace 4 meses. Sus signos vitales y el resto de la explora‐ ción física son normales. Su hemoglobina A1c más reciente, hace 2 meses, fue de 7.9%. Hoy su hemoglobina es de 10 g/dL (100 g/L), con volumen corpuscular medio de 72 fL. De los siguientes, el diagnóstico subyacente MÁS probable que causa los síntomas de esta niña es", "options": ["insuficiencia suprarrenal", "enfermedad celiaca", "hipotiroidismo", "enfermedad inflamatoria intestinal"]}, "59": {"stem": "Un lactante de 6 semanas es llevado a consulta por irritabilidad. Su madre refiere que desde hace una semana llora en exceso. Suele llorar por la tarde-noche durante 3 horas y es difícil de consolar. Ella ha intentado envol‐ verlo y consolarlo, sin éxito. Ha estado afebril, se alimenta bien del seno materno, y sus micciones y evacuacio‐ nes son normales. La exploración física es normal. La madre pregunta qué tratamiento podría ayudar a su bebé. De las siguientes, la MEJOR recomendación es", "options": ["tratamiento con antiácidos", "dieta de eliminación para la madre", "probióticos", "simeticona"]}, "60": {"stem": "Una niña acude con su madre a su consulta de control. Está sentada en silencio leyendo un libro, lo cual puede hacer con solo un poco de ayuda de su madre. Se revisan su participación en actividades propias de su edad y su desarrollo. Este año se unió a un equipo de futbol y disfruta mucho practicar deportes competitivos. Matemáticas es su materia favorita; están aprendiendo fracciones. Menciona a varios amigos y dice que le gusta jugar tanto con niños como con niñas, pero no tiene un solo mejor amigo. De las siguientes, la edad MÁS probable de esta niña es", "options": ["4 años", "6 años", "8 años", "10 años"]}, "61": {"stem": "Una adolescente de 17 años acude a su consulta de control. En sus antecedentes destaca el diagnóstico de leu‐ cemia linfoblástica aguda de células T a los 12 años. Recibió quimioterapia y radioterapia craneal de 1,800 cGy. Terminó todo el tratamiento hace 2 años y se mantiene en remisión completa. Se comenta la importancia de una alimentación saludable, sobre todo por el tratamiento que recibió. De las siguientes, la MEJOR descripción de cómo se compara con sus pares es que tiene", "options": ["una tasa metabólica basal más alta", "un requerimiento mayor de proteínas", "mayor riesgo de presentar anorexia nerviosa", "mayor riesgo de presentar síndrome metabólico"]}, "62": {"stem": "Una recién nacida de 35 semanas de gestación nace de manera precipitada en su domicilio. La madre llevó con‐ trol prenatal de rutina. El padre las traslada en automóvil al hospital más cercano, mientras la madre sostiene a la neonata envuelta en una manta de recepción húmeda. A su llegada a urgencias, la neonata tiene una temperatura de 35.6 °C, frecuencia cardiaca de 92 latidos/min, frecuencia respiratoria de 15 respiraciones/min, presión arterial de 55/37 mm Hg y saturación de oxígeno por oximetría de pulso de 87% al aire ambiente. Sus extremidades es‐ tán frías. De los siguientes, el mecanismo MÁS probable de la pérdida de calor de esta neonata es", "options": ["conducción", "convección", "evaporación", "radiación"]}, "63": {"stem": "Una niña de 18 meses es llevada a urgencias por una lesión en el brazo izquierdo. Veinte minutos antes de llegar, caminaba por la calle tomada de la mano de su padre cuando se resbaló. No llegó a caer al suelo porque su pa‐ dre la sujetó con fuerza de la muñeca; sin embargo, desde entonces llora y no mueve el brazo izquierdo. En la ex‐ ploración física llora cuando alguien se le acerca y mantiene el brazo izquierdo pegado al cuerpo, con el codo li‐ geramente flexionado. Se informa a los padres que la condición de su hija puede resolverse con una maniobra rápida. De las siguientes, la intervención con MAYOR probabilidad de éxito es", "options": ["hiperflexión", "hiperextensión", "hiperpronación", "hipersupinación"]}, "64": {"stem": "Un recién nacido varón de 2 horas de vida es valorado en el cunero por dificultades para alimentarse. Nació por parto vaginal eutócico a las 40 semanas de gestación; su madre, primigesta, ha estado sana y tuvo un embarazo sin complicaciones. La madre refiere dificultad para que el bebé se prenda al pecho y nota que su lengua parece estar “pegada” al piso de la boca. De los siguientes, el MEJOR abordaje para este binomio madre-hijo es", "options": ["ofrecer apoyo en lactancia", "realizar una frenotomía", "proporcionar un extractor de leche", "proporcionar leche humana de donadora"]}, "65": {"stem": "Una niña de 7 años acude a su consulta de control. A su madre le preocupa que es la más pequeña de su grupo. En sus antecedentes destaca la colocación de tubos de ventilación a los 2 años por múltiples episodios de otitis media aguda. No toma medicamentos. En general le va bien en segundo grado de primaria, pero requiere ayuda adicional en matemáticas. El resto del interrogatorio por aparatos y sistemas no es relevante. Su talla blanco fami‐ liar ajustada es de 164 cm (percentil 50 para una mujer adulta) y la edad de inicio de la pubertad de ambos pa‐ dres fue normal. Sus signos vitales son normales para la edad. Su curva de crecimiento se muestra en la Figura 65. Su índice de masa corporal es de 15.4 kg/m2 (percentil 50). La exploración física es normal. La radiografía para edad ósea se interpreta como concordante con su edad cronológica. Figura 65. Curva de crecimiento de la niña descrita en el caso. De los siguientes, el estudio que con MAYOR probabilidad conducirá al diagnóstico de esta niña es", "options": ["factor de crecimiento similar a la insulina tipo 1 (IGF-1)", "cariotipo", "hormona estimulante de la tiroides", "anticuerpos IgA antitransglutaminasa tisular"]}, "66": {"stem": "Una niña de 1 año con fiebre alta es llevada a urgencias. La fiebre comenzó hace 4 días; hace 2 días fue valorada en un centro de atención inmediata, donde se diagnosticó una enfermedad viral y se indicó paracetamol en caso necesario. Desde entonces ha seguido con fiebre. Esta mañana, sus padres le registraron una temperatura rectal de 39.1 °C, le dieron una dosis de paracetamol y la llevaron a urgencias. Era previamente sana, con crecimiento y desarrollo normales, y tiene su esquema de vacunación completo. Tiene temperatura de 37.9 °C, frecuencia car‐ diaca de 102 latidos/min, presión arterial de 98/62 mm Hg, frecuencia respiratoria de 22 respiraciones/min y satu‐ ración de oxígeno de 98% al aire ambiente. Está despierta, alerta y sonriente en brazos de su madre. En la explo‐ ración física se palpan ganglios pequeños y móviles en ambas cadenas cervicales anteriores, y la membrana tim‐ pánica derecha se observa como en la Figura 66. El resto de la exploración física no muestra alteraciones. Un pa‐ nel viral rápido nasal es positivo para parainfluenza. Figura 66. Membrana timpánica derecha de la niña descrita en el caso. Cortesía de D McCormick; reproducida con autorización de Siegel RM, Bien JP. Acute otitis media in children: a continuing story. Pediatr Rev. 2004;25(6):189. Se muestran los resultados de laboratorio: Prueba Resultado Leucocitos 3,100/µL (3.1 × 109/L) Hemoglobina 11.9 g/dL (119 g/L) Plaquetas 412 × 103/µL (412 × 109/L) Neutrófilos totales 120/µL (0.12 × 109/L) Linfocitos totales 2,800/µL (2.8 × 109/L) De los siguientes, el paso MÁS adecuado a continuación en el tratamiento es", "options": ["solicitar valoración por otorrinolaringología para timpanocentesis y cultivo del líquido del oído medio", "tomar un hemocultivo y administrar cefepima por vía parenteral", "indicar amoxicilina con ácido clavulánico por vía oral durante 10 días y egresarla a su domicilio", "tranquilizar a los padres y egresarla con indicación de continuar con paracetamol"]}, "67": {"stem": "Un niño de 3 años ingresa a la Unidad de Terapia Intensiva Pediátrica por insuficiencia respiratoria aguda que re‐ quiere intubación y ventilación mecánica. Se necesita un acceso venoso central, y se intenta varias veces colocar un catéter subclavio derecho sin lograr un acceso definitivo. Después se coloca un catéter en la vena yugular in‐ terna derecha y se transduce una curva de presión venosa central antes de fijarlo con sutura. Poco después, el estado respiratorio del paciente empeora y requiere presiones inspiratorias máximas y fracciones inspiradas de oxígeno más altas para evitar desaturaciones. Se obtiene una radiografía de tórax (Figura 67). Figura 67. Radiografía de tórax del paciente descrito en el caso. Cortesía de J Kane. De las siguientes, la intervención MÁS adecuada es", "options": ["realizar una tomografía computarizada de tórax", "realizar descompresión con aguja de un neumotórax izquierdo", "colocar una sonda pleural (toracostomía) en el hemitórax derecho", "retirar el catéter venoso central yugular interno derecho"]}, "68": {"stem": "Una niña de 6 años es evaluada por una “zona calva” en el cuero cabelludo que se notó por primera vez hace 3 semanas. Desde entonces, el área se ha hecho un poco más pequeña. La niña ha estado sana y no toma medi‐ camentos. Su temperatura es de 37 °C y sus demás signos vitales son normales. La exploración física es normal, excepto por una placa redonda de pérdida casi completa del cabello en la región parietal del cuero cabelludo. El cuero cabelludo se ve normal, sin eritema ni descamación (Figura 68). Figura 68. Placa de alopecia casi completa. Cortesía de D Krowchuk. De los siguientes, el manejo MÁS adecuado de la condición de esta niña es", "options": ["griseofulvina por vía oral", "mupirocina por vía tópica", "ninguna intervención", "referencia a terapia cognitivo-conductual"]}, "69": {"stem": "Un recién nacido de 1 día ingresa a la UCIN por hipoglucemia persistente. Nació a las 40 semanas de gestación por cesárea debido a falta de progresión del trabajo de parto. Por lo demás, el embarazo transcurrió sin complica‐ ciones. Pesó 3,400 g al nacer. A las 8 horas de vida presentó temblores, por lo que se midió la glucosa plasmá‐ tica, que fue de 28 mg/dL (1.6 mmol/L). A pesar de la alimentación oral con fórmula estándar, no logró mantener la glucosa plasmática por arriba de 50 mg/dL (2.8 mmol/L). Requiere una carga de glucosa de 8 mg/kg/min para mantener cifras normales. Está afebril y sus signos vitales son normales para la edad. La exploración física es normal, excepto la de genitales: el testículo derecho no se palpa y el izquierdo se palpa en la parte alta del es‐ croto. La longitud del pene estirado es de 1.6 cm. De las siguientes, la causa MÁS probable de la hipoglucemia de este neonato es", "options": ["un trastorno de la oxidación de los ácidos grasos", "una glucogenosis", "hiperinsulinismo", "hipopituitarismo"]}, "70": {"stem": "Un adolescente de 15 años es evaluado por dolor en la rodilla izquierda de 4 meses de evolución. El dolor co‐ menzó mientras jugaba en 2 equipos de basquetbol diferentes, pero niega una lesión específica. El dolor es prin‐ cipalmente anterior y medial a la rótula y empeora durante y después de la actividad. Hace varias semanas pre‐ sentó aumento de volumen intermitente de la rodilla izquierda y refiere que a veces la rodilla “se atora” en una po‐ sición. No tiene molestias en otras articulaciones y por lo demás está sano. En la exploración de la rodilla iz‐ quierda hay derrame leve, dolor leve a la palpación sobre la cara anteromedial del cóndilo femoral medial, y dolor con la flexión mayor de 90 grados y con la extensión contra resistencia. La rodilla es estable a las pruebas de es‐ trés en valgo y en varo, y las pruebas de Lachman y del cajón posterior son negativas. La marcha es antiálgica. Tiene dolor al intentar ponerse en cuclillas y al saltar. De los siguientes, el MEJOR paso a continuación en el manejo de este adolescente es", "options": ["solicitar biometría hemática completa y proteína C reactiva", "indicar muletas y solicitar radiografías de la rodilla", "colocar un vendaje compresivo e indicar fisioterapia", "referirlo a reumatología para artrocentesis y análisis del líquido sinovial"]}, "71": {"stem": "Un niño de 9 años es llevado a urgencias después de presentar un síncope mientras jugaba futbol. Corría por la cancha cuando se desvaneció. Ya había recuperado el estado de alerta cuando su entrenador llegó a su lado. Por lo demás está sano, y sus signos vitales son normales. Está despierto, alerta y obedece órdenes. La exploración física es normal. Su electrocardiograma se muestra en la Figura 71. Figura 71. Electrocardiograma del paciente descrito en el caso. Cortesía de M McBride. De los siguientes, el diagnóstico MÁS probable en este paciente es", "options": ["bloqueo auriculoventricular", "QTc prolongado", "bloqueo de rama derecha del haz de His", "síndrome del seno enfermo"]}, "72": {"stem": "Una adolescente de 14 años sin antecedentes médicos relevantes es llevada por su madre al consultorio pediá‐ trico para evaluar una masa en la mama. Cuatro días antes del inicio de su menstruación notó un dolor sordo y una “bolita” en la mama derecha. El dolor desapareció durante la menstruación, pero la masa persiste. No ha no‐ tado enrojecimiento, aumento de volumen ni secreción por el pezón. Su menarca fue a los 12 años y sus ciclos han sido regulares. No ha iniciado vida sexual. Su abuela paterna tuvo cáncer de mama a los 65 años. Sus signos vitales son normales para la edad. Hay un nódulo de 2 × 2 cm, de consistencia ahulada y móvil, en el cuadrante superior externo de la mama derecha. No hay eritema, induración ni dolor a la palpación. No hay retracción del pezón ni de la piel. No hay adenopatías cervicales, axilares ni inguinales. El resto de la exploración física es normal. De los siguientes, el paso MÁS adecuado a continuación en el manejo es", "options": ["vigilar la masa durante los siguientes 2 ciclos menstruales", "solicitar una mastografía", "solicitar un ultrasonido de la mama derecha", "programar una biopsia excisional"]}, "73": {"stem": "Una niña de 18 meses, previamente sana, acude a su consulta de control. Nació a término tras un embarazo y un parto sin complicaciones. Hace 6 meses cumplía sus hitos del desarrollo: tenía una pinza fina bien desarrollada, daba pasos sola, decía una palabra además de “mamá” y “papá” y comenzaba a señalar. Hoy su madre refiere que no ha aprendido palabras nuevas, que ya no dice “mamá” ni “papá” y que ya no señala lo que quiere. A veces se ve torpe al intentar tomar juguetes o jugar con ellos. Pesa 11 kg (percentil 46), mide 80 cm (percentil 40) y su perímetro cefálico es de 44 cm (percentil 3). Su curva de perímetro cefálico se muestra en la Figura 73. En la ex‐ ploración física está despierta y alerta, con escaso contacto visual, dificultad para involucrarse en el juego y sin palabras comprensibles. Los nervios craneales son normales. En la exploración motora presenta hipotonía leve en las 4 extremidades, con fuerza completa, reflejos de estiramiento muscular normales y sensibilidad, coordina‐ ción y marcha normales. El resto de la exploración es normal. Figura 73. Curva de perímetro cefálico. Cortesía de J Goldstein. De los siguientes, el diagnóstico MÁS probable en esta niña es", "options": ["adrenoleucodistrofia", "síndrome de Landau-Kleffner", "síndrome de Rett", "síndrome de Zellweger"]}, "74": {"stem": "Una lactante de 1 mes acude a su consulta de control. Nació a las 38 semanas de gestación por cesárea debido a presentación pélvica. En la exploración física destaca una maniobra de Ortolani positiva en el lado derecho. El ul‐ trasonido de cadera confirma el diagnóstico sospechado. De los siguientes, el mecanismo MÁS probable de su condición es", "options": ["asociación", "secuencia de deformación", "secuencia de disrupción", "síndrome de malformación"]}, "75": {"stem": "Un niño de 11 años es llevado a urgencias por náusea, vómito, cólicos abdominales y diarrea acuosa de inicio sú‐ bito hace 3 días. Una semana antes del inicio ayudó a su abuela a preparar una comida que incluía intestinos de cerdo (tripas). Otros familiares también han enfermado con un cuadro gastrointestinal similar. En sus anteceden‐ tes destaca β-talasemia mayor, por la que recibe transfusiones mensuales desde la lactancia y tratamiento con un quelante de hierro. Su temperatura es de 38 °C. Tiene mucosas secas y ojos hundidos. El llenado capilar es de 3 segundos. Se muestran los resultados de laboratorio: Prueba Resultado Leucocitos 33,200/µL (33.2 × 109/L) Neutrófilos 82% Bandas 10% Linfocitos 7% Monocitos 1% Sodio 130 mEq/L (130 mmol/L) De las siguientes, la causa MÁS probable de su enfermedad es", "options": ["Bacillus cereus", "Salmonella enterica", "Shigella sonnei", "Yersinia enterocolitica"]}, "76": {"stem": "Un adolescente de 16 años es llevado al consultorio por su padre debido a preocupaciones sobre su conducta. Le iba bien en la escuela hasta este último año. Su padre siente que su motivación por el rendimiento académico ha disminuido, y hace poco se enteró de que se ha estado saltando clases. El adolescente se ha aislado y pasa el tiempo en su cuarto durmiendo siestas o jugando videojuegos. No quiere ir cuando su padre le propone salidas familiares. Discuten constantemente. El adolescente había evolucionado bien con el tratamiento para el trastorno por déficit de atención con hiperactividad, con una combinación de terapia conductual, apoyo escolar y un medi‐ camento estimulante. Tanto el padre como el hijo refieren que recientemente ha tenido más dificultad con la dis‐ tracción y la falta de atención. Al entrevistarlo por separado, el adolescente dice que su padre es demasiado con‐ trolador y no lo deja salir con sus amigos, y que juega videojuegos porque está “aburrido” y no hay nada más que hacer. En la exploración física se observa que ha aumentado 4.5 kg (10 libras) desde su última consulta, hace 2 meses. De las siguientes, la afirmación MÁS precisa sobre la conducta de este adolescente es que", "options": ["ajustar la dosis del medicamento resolverá las preocupaciones conductuales", "la psicoterapia interpersonal es una opción de tratamiento adecuada", "las conductas son compatibles con los cambios de humor normales de la adolescencia", "el tratamiento debe incluir la prescripción de un estabilizador del estado de ánimo"]}, "77": {"stem": "Un adolescente de 15 años, sano, es llevado a urgencias por sospecha de intoxicación aguda. Hace varias horas sus padres lo encontraron sentado solo en un baño con un olor penetrante, rodeado de parafernalia para consu‐ mir drogas. No podía responder de forma coherente. En la exploración física tiene temperatura de 37.5 °C, fre‐ cuencia cardiaca de 110 latidos/min, frecuencia respiratoria de 22 respiraciones/min, presión arterial de 130/85 mm Hg y saturación de oxígeno por oximetría de pulso de 98% al aire ambiente. Se mueve con lentitud y se ve algo desaliñado. Responde algunas preguntas de forma adecuada y otras sin sentido. Refiere alucinaciones audi‐ tivas. El resto de la exploración física es normal. De las siguientes, la causa MÁS probable de los síntomas de este adolescente es", "options": ["cocaína", "heroína", "lisergamida (LSD)", "mariguana"]}, "78": {"stem": "Un agente de policía llega al servicio de urgencias con una adolescente de 17 años esposada, agitada, agresiva y desaliñada. La policía fue llamada a una fiesta universitaria y la encontró peleando con otra joven en el jardín de la casa. Los agentes intentaron convencerla de subir voluntariamente a la patrulla, pero tuvieron que someterla después de que mordió a un policía y golpeó a otro en la cara. En urgencias está combativa; grita e insulta a los policías y al personal del hospital. En la exploración física tiene fiebre, hipertensión, taquicardia, taquipnea y diafo‐ resis. Sus pupilas están dilatadas. Presenta aumento de volumen periorbitario izquierdo y del labio inferior, y abra‐ siones superficiales en el dorso de ambas manos. No tiene soplos cardiacos, los campos pulmonares están lim‐ pios y el abdomen es blando y no doloroso. De las siguientes, la sustancia que con MAYOR probabilidad causa los síntomas de esta adolescente es", "options": ["anfetamina", "benzodiacepina", "dietilamida del ácido lisérgico (LSD)", "psilocibina"]}, "79": {"stem": "Una jugadora de basquetbol de 16 años es evaluada por mareo persistente. Hace una semana chocó con otra ju‐ gadora durante un partido. Siguió jugando, pero a los pocos minutos presentó cefalea importante. En urgencias se le diagnosticó una conmoción cerebral y se le indicó reposo durante varios días y seguimiento con su médico de primer contacto. Actualmente se siente mucho mejor, excepto por mareo persistente y la sensación de estar “desequilibrada”, sobre todo con los cambios de posición. En la exploración física, el mareo se provoca con los movimientos de la cabeza y los cambios de posición. El resto de la exploración neurológica no muestra datos fo‐ cales. El resto de la exploración es normal, incluidos arcos de movilidad completos e indoloros del cuello. De los siguientes, el MEJOR paso a continuación en el manejo de esta adolescente sería", "options": ["pruebas neuropsicológicas computarizadas", "continuar en reposo hasta que se resuelvan los síntomas", "resonancia magnética de encéfalo", "referencia a rehabilitación vestibular"]}, "80": {"stem": "Un niño de 11 años acude a consulta por fiebre. Desde hace 10 días tiene fiebre diaria de al menos 39 °C. Tam‐ bién presenta malestar general, disminución del apetito, dolor abdominal y dolor de espalda. No ha tenido exan‐ tema ni contacto con enfermos o mascotas. Hace 3 semanas viajó a México y comió queso elaborado en el ran‐ cho lechero de su familia. No tuvo contacto con los animales del rancho. Sus signos vitales son: temperatura de 39.1 °C, frecuencia cardiaca de 95 latidos/min, frecuencia respiratoria de 18 respiraciones/min y presión arterial de 98/57 mm Hg. La exploración física muestra hepatoesplenomegalia, sin linfadenopatías. De los siguientes, el microorganismo que con MAYOR probabilidad es responsable de la enfermedad de este niño es", "options": ["Bartonella henselae", "Brucella melitensis", "Francisella tularensis", "Salmonella Typhi"]}, "81": {"stem": "Un adolescente de 17 años acude a consulta por dolor epigástrico de varios años de evolución que ha empeorado de forma importante en los últimos 6 meses. Hace 2 meses se le prescribió un inhibidor de la bomba de protones y, a pesar de un buen apego al tratamiento, sigue con dolor abdominal. Ha probado antiácidos de venta libre, con mejoría leve y transitoria. Niega vómito, regurgitación, pirosis y pérdida de peso. Llegó de Nepal hace 2 años. Por lo demás está sano y no tiene alergias conocidas a medicamentos. En la exploración física pesa 53.7 kg (percentil 11 para la edad), mide 165 cm (percentil 10) y su índice de masa corporal es de 19.7 kg/m2 (percentil 30). El ab‐ domen es blando, con dolor a la palpación en el epigastrio. No hay hepatoesplenomegalia. El resto de la explora‐ ción es normal. Estudios de laboratorio recientes: Prueba Resultado Hemoglobina 15.5 g/dL (155 g/L) Alanina aminotransferasa 27 U/L Aspartato aminotransferasa 32 U/L Albúmina 4.7 g/dL (47 g/L) La endoscopia muestra nodularidad en el antro gástrico y una úlcera duodenal (Figura 81). Las biopsias muestran gastritis crónica y duodenitis erosiva, ambas con bacilos gramnegativos de forma espiral. Se recomienda trata‐ miento de erradicación para la condición sospechada. Figura 81. Úlcera duodenal. Cortesía de J Sullivan. De las siguientes, la MEJOR indicación para este tratamiento es", "options": ["la gastritis crónica", "la úlcera duodenal", "el dolor epigástrico", "la regurgitación"]}, "82": {"stem": "Se evalúa en la UCIN a un recién nacido varón de término. El embarazo se complicó con disminución de los movi‐ mientos fetales y polihidramnios. Fue intubado inmediatamente después del nacimiento por dificultad respiratoria e hipotonía, y ha seguido requiriendo apoyo respiratorio. Tiene labio superior “en tienda de campaña”, hipotonía y pie equino varo bilateral. Su madre tiene párpados caídos y dificultad para soltar la mano después de saludar. Re‐ fiere tener un marcapasos cardiaco y cataratas bilaterales. De los siguientes, el diagnóstico MÁS probable en este neonato es", "options": ["distrofia muscular de Duchenne", "enfermedad de Huntington", "distrofia miotónica tipo 1", "síndrome de Prader-Willi"]}, "83": {"stem": "Un niño de 10 años acude a su consulta de control. Ni él ni su familia tienen preocupaciones sobre su salud. En sus antecedentes médicos y quirúrgicos destaca otitis media recurrente; se le colocaron tubos de ventilación bila‐ terales hace 5 años, que se expulsaron aproximadamente al año. El aspecto de su membrana timpánica se mues‐ tra en la Figura 83. El tamiz auditivo es normal. Figura 83. Aspecto de la membrana timpánica del paciente descrito en el caso. Cortesía de J McClay. De los siguientes, el diagnóstico MÁS probable en este paciente es", "options": ["colesteatoma", "otitis media crónica con derrame", "miringoesclerosis", "perforación de la membrana timpánica"]}, "84": {"stem": "Un niño de 7 años es llevado a urgencias por orina color “refresco de cola” y disminución del volumen urinario de 1 día de evolución. No ha tenido fiebre, exantema, diarrea, vómito, polaquiuria ni ardor al orinar. Hace 2 semanas tuvo dolor de garganta. Tiene frecuencia cardiaca de 108 latidos/min, frecuencia respiratoria de 20 respiraciones/min y presión arterial de 130/90 mm Hg. Presenta edema facial y edema leve con fóvea en ambas extremidades inferiores. Los campos pulmonares están limpios y el resto de la exploración no muestra alteracio‐ nes. Se muestran los resultados de laboratorio: Prueba Resultado Sangre Sodio 132 mEq/L (132 mmol/L) Potasio 5.0 mEq/L (5.0 mmol/L) Cloro 100 mEq/L (100 mmol/L) Bicarbonato 22 mEq/L (22 mmol/L) Nitrógeno ureico en sangre 28 mg/dL (10.0 mmol/L) Creatinina 1.8 mg/dL (159 µmol/L) Albúmina 2.5 g/dL (25 g/L) Complemento C3 16 mg/dL (0.16 g/L) (referencia, 85-142 mg/dL [0.85-1.42 g/L]) Complemento C4 22 mg/dL (0.22 g/L) (referencia, 12-41 mg/dL [0.12-0.41 g/L]) Antiestreptolisinas O 800 UI Orina Sangre 3+ Proteínas 3+ Eritrocitos 50-100/campo Leucocitos 5-10/campo De los siguientes, el tratamiento MÁS adecuado para este niño es", "options": ["furosemida por vía intravenosa", "solución salina al 0.9% por vía intravenosa", "enalapril por vía oral", "prednisona por vía oral"]}, "85": {"stem": "Una adolescente de 15 años es llevada a urgencias por dificultad respiratoria. Sus padres refieren que hace 2 se‐ manas comenzó con datos de una infección leve de vías respiratorias, pero hoy empeoró de forma súbita. Se ve marmórea y con dificultad respiratoria moderada. Tiene temperatura de 37.5 °C, frecuencia cardiaca de 155 latidos/min, frecuencia respiratoria de 20 respiraciones/min, presión arterial de 105/65 mm Hg y saturación de oxí‐ geno de 90% al aire ambiente. Está despierta, pero somnolienta. En la exploración pulmonar hay estertores crepi‐ tantes y roncus difusos, sin sibilancias. A la auscultación cardiaca, el precordio está quieto y se escuchan un soplo sistólico grado 3/6 y un soplo diastólico grado 2/6. El abdomen es blando y el borde hepático se palpa 5 a 6 cm por debajo del reborde costal derecho. La piel está marmórea y fría, con pulsos distales apenas palpables. El lle‐ nado capilar es de 5 segundos. Hay edema 2+ en ambas piernas, hasta las rodillas. El resto de la exploración no aporta datos. Se inicia oxígeno, se establece un acceso vascular y se toman muestras de sangre para estudios de laboratorio. De las siguientes, la infusión de medicamento MÁS adecuada para iniciar es", "options": ["milrinona", "norepinefrina", "prostaglandina", "vasopresina"]}, "86": {"stem": "Un adolescente de 14 años acude a su consulta de control. No tiene molestias, su desarrollo ha sido normal y practica varios deportes. A los 6 años se le colocó un clavo intramedular por una fractura de la diáfisis del fémur izquierdo. Las radiografías posteriores mostraron inicialmente un crecimiento normal del fémur izquierdo; sin em‐ bargo, el adolescente no continuó con su seguimiento ortopédico. En la exploración física hay una asimetría im‐ portante de las crestas ilíacas: la cadera izquierda se ve más alta que la derecha. Tiene arcos de movilidad com‐ pletos, con fuerza normal y simétrica en la exploración de la espalda, las caderas y las rodillas. La medición de la longitud de las piernas desde la espina ilíaca anterosuperior hasta el maléolo medial muestra que la pierna iz‐ quierda es 2 cm más larga que la derecha. De los siguientes, el MEJOR paso a continuación en el manejo de este adolescente es", "options": ["citarlo en 6 meses para repetir la medición", "tranquilizar a la familia explicándole que este hallazgo es frecuente", "referirlo a un cirujano ortopedista", "referirlo a un ortesista para una alza en el talón"]}, "87": {"stem": "Una niña de 4 años es evaluada por empeoramiento de tos y sibilancias persistentes, presentes desde hace 3 años. Ha recibido budesonida inhalada y salbutamol sin resolución de los síntomas. Tiene dolor intermitente en la región lateral derecha del abdomen, que no interfiere con el sueño ni con sus actividades. En la exploración física tiene aspecto sano, con signos vitales y parámetros de crecimiento normales. La saturación de oxígeno por oxi‐ metría de pulso es de 96% al aire ambiente. Tiene congestión nasal, pero el resto de la exploración de la vía aé‐ rea superior es normal. No hay aumento del trabajo respiratorio. No se auscultan ruidos agregados, pero los rui‐ dos respiratorios están disminuidos en el hemitórax derecho. La exploración cardiaca es normal. El hígado se palpa 5 cm por debajo del reborde costal derecho; el bazo no se palpa. No hay hipocratismo digital. Se obtiene una radiografía de tórax (Figura 87). Figura 87. Radiografías de tórax de la niña descrita en el caso. Cortesía de M Guill. De los siguientes, el paso MÁS adecuado a continuación para establecer el diagnóstico es", "options": ["tomografía computarizada de tórax con contraste intravenoso", "broncoscopia flexible con lavado broncoalveolar", "estudio de deglución con bario modificado con terapeuta de lenguaje", "biopsia toracoscópica del lóbulo inferior derecho"]}, "88": {"stem": "Una adolescente de 17 años con trastorno bipolar y trastorno negativista desafiante es llevada a urgencias desde un centro de internamiento para adolescentes por pérdida de peso en las últimas 2 semanas. Cumple una medida de internamiento de 6 semanas por robarle el automóvil a su madre y no cumplir con las condiciones de su liber‐ tad condicional. Refiere que no ha podido dormir, que tiene temblores y que ha disminuido su apetito. Ha tenido dolor abdominal intermitente, sin náusea ni vómito. Ha perdido aproximadamente 5 kg en las últimas 2 semanas. Niega intentar bajar de peso de forma intencional. Se niega a responder preguntas sobre consumo de tabaco, al‐ cohol o drogas. Su última menstruación fue hace 2 meses, y hace 1 mes se le colocó un implante anticonceptivo. Tiene temperatura de 37 °C, frecuencia cardiaca de 120 latidos/min, presión arterial de 108/74 mm Hg y frecuen‐ cia respiratoria de 20 respiraciones/min. Pesa 49 kg (percentil 10) y mide 164 cm (percentil 50). Se ve inquieta. El resto de la exploración física no muestra alteraciones. De los siguientes, el diagnóstico MÁS probable en esta paciente es", "options": ["insuficiencia suprarrenal", "anorexia nerviosa", "abstinencia de cannabis", "hipertiroidismo"]}, "89": {"stem": "Una recién nacida de término de 2 días es evaluada en el cunero por disminución de la alimentación y somnolen‐ cia. Sus padres refieren que en las últimas horas ha sido difícil despertarla. Tomó 45 mL (1.5 onzas) de fórmula hace 3 horas. Presenta hipotonía y tiene presión arterial de 70/40 mm Hg, temperatura de 37.2 °C, frecuencia car‐ diaca de 180 latidos/min y frecuencia respiratoria de 80 respiraciones/min. Se muestran los resultados de laboratorio: Prueba Resultado Leucocitos 7,000/µL (7.0 × 109/L) Amonio 210 µg/dL (150 µmol/L) Glucosa 40 mg/dL (2.2 mmol/L) Creatinina 0.2 mg/dL (18 µmol/L) Nitrógeno ureico en sangre 15 mg/dL (5.4 mmol/L) Dióxido de carbono total 12 mEq/L (12 mmol/L) Brecha aniónica 24 mEq/L (24 mmol/L) Lactato 41 mg/dL (4.6 mmol/L) El examen general de orina es positivo para cetonas. De los siguientes, el diagnóstico MÁS probable es", "options": ["trastorno de la oxidación de los ácidos grasos", "acidemia orgánica", "fenilcetonuria", "defecto del ciclo de la urea"]}, "90": {"stem": "Una niña de 2 años acude a su consulta de control. Ha estado sana y su desarrollo es adecuado. Sus padres se están divorciando y planean vivir en la misma colonia para poder pasar con su hija el mayor tiempo posible. Desean saber cómo podría reaccionar su hija ante esta transición en sus vidas. De las siguientes, la respuesta MÁS probable de la niña es", "options": ["indiferencia aparente", "culparse a sí misma de la situación", "pérdida de habilidades motoras", "ansiedad de separación"]}, "91": {"stem": "Se evalúa en el cunero a una recién nacida de 35 semanas de gestación. Nació por cesárea debido a preeclam‐ psia materna grave y presentación pélvica. Su madre tiene antecedente de diabetes gestacional y un tamiz nega‐ tivo para estreptococo del grupo B. En la sala de partos, la neonata requirió ventilación con presión positiva du‐ rante 30 segundos por esfuerzo respiratorio disminuido. Orinó en la sala de partos. En el cunero, sus signos vita‐ les son: temperatura de 36.5 °C, frecuencia cardiaca de 156 latidos/min, frecuencia respiratoria de 45 respiraciones/min, presión arterial de 52/22 mm Hg, con presión arterial media de 32 mm Hg, y saturación de oxí‐ geno por oximetría de pulso de 95% al aire ambiente. En la exploración física se ve tranquila, con trabajo respira‐ torio normal y pulsos periféricos 2+. De los siguientes, el MEJOR paso a continuación en el manejo de esta neonata es", "options": ["administrar un bolo de solución salina al 0.9%", "continuar con los cuidados de rutina", "tomar un hemocultivo e iniciar antibióticos", "iniciar una infusión de prostaglandina"]}, "92": {"stem": "Una niña de 10 años ha tenido neumonía al menos una vez al año desde los 2 años. Cuando enferma, suele pre‐ sentar de forma súbita fiebre, tos, malestar general, dolor torácico y dificultad para respirar. Las radiografías de tó‐ rax han mostrado consolidaciones segmentarias o lobares de localización variable. Se recupera con amoxicilina; su radiografía de tórax de seguimiento más reciente se muestra en la Figura 92. También ha tenido otitis media recurrente que requirió la colocación de tubos de ventilación. Sus parámetros de crecimiento son normales y, salvo membranas timpánicas con cicatrices y secreción nasal mucoide, el resto de la exploración de la vía aérea superior no muestra alteraciones. Los ruidos respiratorios son claros y los ruidos cardiacos son normales y se auscultan mejor a la derecha del esternón. El borde hepático se palpa en el reborde costal izquierdo. Figura 92. Radiografía de tórax de la niña descrita en el caso. Cortesía de M Guill. De los siguientes, el mecanismo fisiopatológico MÁS probable de los episodios de neumonía de esta niña es", "options": ["deficiencia funcional de inmunoglobulina G", "alteración de la depuración mucociliar", "estallido oxidativo inadecuado de los neutrófilos", "inmunodeficiencia de células T"]}, "93": {"stem": "Un niño de 6 años que recibe quimioterapia de mantenimiento por leucemia linfoblástica aguda es llevado a ur‐ gencias porque hace 2 días presentó un exantema ardoroso en la cara. Sus medicamentos incluyen pulsos men‐ suales de prednisona y vincristina, 6-mercaptopurina oral diaria y metotrexato oral semanal. Sus signos vitales son normales para la edad. Presenta lesiones vesiculares eritematosas en el labio superior, el párpado derecho y el lado derecho de la frente. El resto de la exploración física no muestra alteraciones. Se diagnostica herpes zós‐ ter y se le hospitaliza para administrar aciclovir intravenoso. Su nitrógeno ureico en sangre es de 14 mg/dL (5.0 mmol/L) y su creatinina de 0.5 mg/dL (44 µmol/L). De las siguientes, la medida MÁS adecuada para prevenir la nefrotoxicidad por fármacos en este niño es", "options": ["alcalinización de la orina", "dosificación con intervalos prolongados", "hidratación con líquidos isotónicos", "vigilancia de los niveles séricos del fármaco"]}, "94": {"stem": "Un niño de 31 meses acude a consulta para control de crecimiento. Nació a término; el parto se complicó con he‐ morragia excesiva. Ha estado sano y toma un multivitamínico diario. El interrogatorio completo por aparatos y sis‐ temas no es relevante. Su talla blanco familiar ajustada está en el percentil 40. Sus curvas de crecimiento se muestran en las Figuras 94A y 94B. Sus signos vitales son normales para la edad y la exploración física no mues‐ tra alteraciones. Figura 94A. Longitud y peso para la edad del niño descrito en el Figura 94B. Perímetro cefálico para la edad y peso para la longitud caso. del niño descrito en el caso. Se muestran los resultados de laboratorio: Prueba Resultado Leucocitos 8,300/µL (8.3 × 109/L) Hemoglobina 13 g/dL (130 g/L) Plaquetas 281 × 103/µL (281 × 109/L) Sodio 138 mEq/L (138 mmol/L) Potasio 4.1 mEq/L (4.1 mmol/L) Bicarbonato 25 mEq/L (25 mmol/L) Creatinina 0.3 mg/dL (26.5 µmol/L) Glucosa 90 mg/dL (5.0 mmol/L) Hormona estimulante de la tiroides 1.4 mUI/L (referencia, 0.27-4.2 mUI/L) Tiroxina libre 1.3 ng/dL (17 pmol/L) (referencia, 0.9-1.7 ng/dL [12-22 pmol/L]) El examen general de orina es normal, salvo una densidad de 1.020 y un pH de 6. De los siguientes, el diagnóstico MÁS probable es", "options": ["enfermedad celiaca", "deficiencia de hormona de crecimiento", "ingesta calórica insuficiente", "acidosis tubular renal"]}, "95": {"stem": "Un niño de 8 años, previamente sano, es atendido en urgencias por síntomas que comenzaron hace 2 días con dolor de garganta leve. Ayer empeoró el dolor de garganta y tuvo fiebre de bajo grado. Llegó de Venezuela hace una semana. Tiene un esquema de vacunación incompleto por el acceso intermitente a las vacunas en su ciudad de origen. Sus signos vitales son: temperatura de 38.2 °C, frecuencia cardiaca de 84 latidos/min, frecuencia respi‐ ratoria de 18 respiraciones/min y presión arterial de 92/53 mm Hg. Los hallazgos de la exploración de la orofa‐ ringe se muestran en la Figura 95. El resto de la exploración física es normal. Figura 95. Hallazgos de la exploración orofaríngea del niño descrito en el caso. Reproducida con autorización de Kimberlin DW, et al, eds. Red Book Online. Itasca, IL: American Academy of Pediatrics; 2018. Se muestran los resultados de laboratorio: Prueba Resultado Prueba rápida para estreptococo del grupo A Negativa Cultivo faríngeo Pendiente Anticuerpos heterófilos Negativos De las siguientes, esta presentación clínica es MÁS preocupante de infección por", "options": ["Candida albicans", "Corynebacterium diphtheriae", "virus de Epstein-Barr", "Streptococcus pyogenes"]}, "96": {"stem": "Hace 3 semanas, a un adolescente de 15 años le apareció una mancha en el tórax. Su madre pensó que podía ser tiña y le aplicó una crema antimicótica de venta libre. Sin embargo, la lesión persistió y, en 1 a 2 semanas, aparecieron muchas lesiones nuevas en el tronco. La erupción es pruriginosa, pero por lo demás el paciente ha estado bien. Sus signos vitales son normales. La exploración física es normal, excepto la piel: hay una erupción extensa que afecta el tórax, el abdomen y la espalda, y respeta la cara, el cuello y las extremidades. La lesión ini‐ cial se encuentra en el lado derecho de la parte superior del tórax (Figura 96). Figura 96. Erupción del adolescente descrito en el caso. Cortesía de D Krowchuk. De los siguientes, el tratamiento MÁS adecuado es", "options": ["griseofulvina por vía oral", "hidroxicina por vía oral", "sulfuro de selenio por vía tópica", "terbinafina por vía tópica"]}, "97": {"stem": "Una recién nacida de 24 días acude al consultorio para su primera consulta tras una estancia sin complicaciones de 23 días en la UCIN. Nació a las 34 semanas de gestación por parto vaginal sin complicaciones; su madre es sana. Pesó 1,780 g al nacer. Según el resumen de egreso, inició la vía oral el primer día y alcanzó el volumen completo de alimentación a los 5 días de vida. Actualmente pesa 2,335 g, mide 47 cm y su perímetro cefálico es de 33 cm. El resto de la exploración física es normal. Su madre prefiere alimentarla con fórmula y pregunta cuál debe darle. Se revisan sus curvas de crecimiento (Figuras 97A y 97B). Figura 97A. Curvas de crecimiento de la neonata descrita en el Figura 97B. Curvas de crecimiento de la neonata descrita en el caso. caso (continuación). Cortesía de K Montez. De las siguientes, la densidad calórica MÁS adecuada de la fórmula para esta neonata es", "options": ["19 kcal/oz (≈0.64 kcal/mL)", "20 kcal/oz (≈0.67 kcal/mL)", "22 kcal/oz (≈0.74 kcal/mL)", "24 kcal/oz (≈0.81 kcal/mL)"]}, "98": {"stem": "Una adolescente de 16 años con sarcoma de Ewing en recaída ingresa a la Unidad de Terapia Intensiva Pediá‐ trica por dificultad respiratoria. El servicio de oncología coincide en que su enfermedad pulmonar aguda se debe a la progresión del tumor y en que no hay más tratamientos oncológicos eficaces disponibles. La paciente y su fami‐ lia dejaron previamente por escrito directrices anticipadas que restringen específicamente la intubación endotra‐ queal y la ventilación mecánica, y establecen que no se realice reanimación cardiopulmonar en caso de paro car‐ diaco. La paciente se ve visiblemente incómoda y con “hambre de aire”, a pesar de los intentos con cánula nasal de alto flujo y del escalamiento a ventilación con presión positiva de dos niveles. Después de comentarlo con la familia, y con el fin de que la paciente esté más cómoda, se le administra una dosis de morfina adecuada para su peso. Poco después presenta hipopnea, con esfuerzo respiratorio superficial. De los siguientes, el paso MÁS adecuado a continuación es", "options": ["administrar naloxona para revertir los efectos de la morfina", "administrar un relajante neuromuscular para detener el esfuerzo de boqueo", "intubar a la paciente hasta que pase el efecto de la morfina", "brindar apoyo a la familia y cuidados compasivos"]}, "99": {"stem": "Un lactante de 6 meses acude a su consulta de control. Su madre ya le introdujo algunos alimentos sólidos, como cereal de arroz, avena y zanahoria, sin reacciones adversas. Sus signos vitales y parámetros de crecimiento son normales. La exploración física es normal, salvo un eccema leve. No hay antecedentes familiares de alergia ali‐ mentaria. La madre pregunta cuándo puede introducir alimentos que contengan cacahuate. De las siguientes, la MEJOR respuesta es que estos alimentos deben introducirse", "options": ["después de realizar pruebas de alergia", "después de que se resuelva el exantema", "ahora, sin pruebas adicionales", "a los 12 meses de edad o después"]}, "100": {"stem": "Una niña de 20 meses es llevada a urgencias tras 36 horas de náusea, vómito no sanguinolento ni bilioso y dia‐ rrea sin sangre. Sus padres refieren que en las últimas 24 horas no ha tolerado líquidos ni sólidos. Ha orinado 2 veces en las últimas 24 horas. Tiene frecuencia cardiaca de 130 latidos/min y frecuencia respiratoria de 26 respiraciones/min, y está afebril. Está somnolienta. Sus mucosas están secas. Los ruidos intestinales están au‐ mentados. No tiene exantema. El llenado capilar es de 3 segundos. Se muestran los resultados de laboratorio: Prueba Resultado Suero Sodio 148 mEq/L (148 mmol/L) Potasio 4.8 mEq/L (4.8 mmol/L) Dióxido de carbono total 19 mEq/L (19 mmol/L) Cloro 111 mEq/L (111 mmol/L) Nitrógeno ureico en sangre 29 mg/dL (10.4 mmol/L) Creatinina 0.6 mg/dL (53 µmol/L) Glucosa 72 mg/dL (4 mmol/L) Orina Densidad 1.025 De las siguientes, la modalidad de tratamiento MÁS recomendable para esta niña es", "options": ["dieta BRAT (plátano, arroz, puré de manzana y pan tostado)", "rehidratación enteral con un producto que contenga lactosa", "rehidratación enteral con solución de rehidratación oral", "hidratación parenteral"]}, "101": {"stem": "Instructions: each item has four options (A–D) and one best answer. Mark your answers on the answer sheet. A 20-month-old, previously healthy boy is being evaluated for poor weight gain for 4 to 5 months, and watery diar‐ rhea, bloating, and poor appetite for 3 weeks. He currently passes stools 4 to 6 times daily, wakes up with stool in his diaper, and has a significant diaper rash. He has had no vomiting or hematochezia. The boy prefers to drink whole milk (generally 20 oz/day) and water. He does not eat many sugary foods and does not drink juice. His fa‐ ther has lactose intolerance and his older brother has type 1 diabetes. The boy’s physical examination findings demonstrate a weight of 10 kg (7th percentile), length of 87 cm (54th percentile), and weight/length less than the 1st percentile. He appears tired and has thin extremities. His abdomen is soft, moderately distended, and non‐ tender, without mass or organomegaly. Moderate diaper dermatitis is present. Stool testing shows the following results: Laboratory Test Result Fecal ova and parasite examination Negative Giardia antigen Negative Fecal bacterial culture Negative Fecal fat 43% (reference range <20%) Pancreatic elastase >500 µg/g (reference range >200) Fecal occult blood Negative Fecal white blood cells Negative Of the following, the MOST likely cause of this boy’s diarrhea is", "options": ["celiac disease", "functional diarrhea", "Shwachman Diamond syndrome", "ulcerative colitis"]}, "102": {"stem": "A 6-month-old male infant who is limp and exhibiting obtundation in the morning is brought to the emergency de‐ partment. Bedside blood analysis reveals a significant metabolic acidosis, including an elevated lactate level and a capillary blood glucose level of 35 mg/dL (1.9 mmol/L) and 3+ ketones in the urine. His newborn screening results were normal. His parents report that he only recently has been able to sleep through the night without waking for a feeding and that he has had a few episodes of morning lethargy that improved after his first morning feeding. The infant appears small and nearly comatose. He has chubby cheeks, a short nose, and a relatively small chin. He has a temperature of 37.8°C, a heart rate of 155 beats/min, a respiratory rate of 15 breaths/min, and a blood pres‐ sure of 75/45 mm Hg. Cardiac examination reveals no murmur and a normal S1 and S2. The liver edge is palpable 3 cm below the right costal margin. The remainder of the physical examination findings are unremarkable. Of the following, the MOST likely diagnosis is", "options": ["fatty acid oxidation disorder", "glycogen storage disorder", "mitochondrial disorder", "organic acid disorder"]}, "103": {"stem": "A 4-year-old girl with short bowel syndrome and on long-term total parenteral nutrition is seen in the emergency department for evaluation of fever, chills, redness, and swelling within 2 cm of her central venous catheter site. She appears ill and has a temperature of 39.1°C, tachycardia, and hypotension. There is marked erythema and in‐ duration surrounding the exit site of the central venous catheter. Blood cultures are obtained from the catheter and a peripheral site, and antibiotic therapy with vancomycin and ceftazidime is initiated. Within 12 hours, both central and peripheral blood cultures grow gram-positive cocci in clusters. Of the following, the BEST next step in management is", "options": ["addition of gentamicin and rifampin", "antibiotic lock therapy", "echocardiography", "removal of the central venous catheter"]}, "104": {"stem": "A 14-year-old adolescent boy is seen for a sports preparticipation physical examination. He and his mother are concerned about his small size. He has no known medical problems and takes no medication. A comprehensive review of systems is unremarkable. His mother is 165 cm tall and had menarche at age 12 years. His father is 178 cm tall and completed his linear growth while in college. His 12-year-old sister is taller than he is at 157 cm and re‐ cently had menarche. His growth chart is shown in Figure 104. His body mass index is 17.3 kg/m2 (18th per‐ centile). His vital signs are normal for age. He appears younger than his chronological age. His sexual maturity rat‐ ing is 1 for pubic hair and genital development. His testicular volume is 3 mL bilaterally. The remainder of his phys‐ ical examination findings are normal. A bone age radiograph has a result of 11 years. Figure 104: Growth chart for the boy described in the vignette. Laboratory data are shown: Laboratory Test Result Luteinizing hormone 0.4 IU/L (reference rangea, <0.1-0.3 IU/L) Follicle-stimulating hormone 2.4 IU/L (reference rangea, 0.26-3 IU/L) Testosterone 15 ng/dL (0.5 nmol/L) (reference rangea, <2.5-10 ng/dL [0.09-0.4 nmol/L]) a Reference ranges are for individuals with a sexual maturity rating of 1. Of the following, the BEST next step is", "options": ["advising the patient to increase the calories in his diet", "brain magnetic resonance imaging", "referral for consideration of growth hormone therapy", "referral for consideration of testosterone therapy"]}, "105": {"stem": "A 15-year-old adolescent is seen in the office for evaluation of recurrent headaches for the past 5 years. Her headaches are described as a bifrontal throbbing pain with associated photophobia, phonophobia, nausea, and vomiting. She feels fatigued and experiences visual distortions with sparkling lights before headache onset. Her headaches occur approximately once weekly and respond to appropriately dosed nonsteroidal anti-inflammatory drugs (NSAIDs). The girl misses school approximately once per semester because of her headaches. She denies waking at night with headache, initiation of headache with valsalva maneuver, or associated focal neurologic deficit. No triggers have been identified. Her neurologic examination findings in the office are normal. Fundoscopy reveals sharp disc margins with no evidence of papilledema. Magnetic resonance imaging of the brain, performed 3 years earlier, was normal. Of the following, in addition to continued use of NSAIDs, the BEST next management step for this girl is", "options": ["initiation of vitamin therapy", "initiation of prophylactic medication", "initiation of triptan", "lifestyle trigger identification and modification"]}, "106": {"stem": "An 8-year-old boy with a 3-day history of low-grade fever, sore throat, nasal discharge, cough, and malaise is seen in the office. He recently returned to school after summer break. He appears well and has a temperature of 38.2°C, a heart rate of 102 beats/min, a respiratory rate of 18 breaths/min, and a blood pressure of 108/67 mm Hg. There is redness of the pharyngeal mucosa without exudate. There is nontender, shotty, anterior cervical adenopa‐ thy. His right tympanic membrane is erythematous. The remainder of his physical examination findings are normal. Of the following, the MOST likely etiology of this child’s illness is", "options": ["adenovirus", "influenza", "respiratory syncytial virus", "rhinovirus"]}, "107": {"stem": "A 15-year-old adolescent is being evaluated for acne. She has used an over-the-counter salicylic acid wash with‐ out benefit. She has been in good health and takes no medications. There are approximately 8 active inflammatory lesions on each cheek and her chin. There are several open comedones (Figure 107), but no scarring. The fore‐ head, chest, and back are free of acne lesions. Figure 107: Acne lesions of the patient described in the vignette. Reprinted with permission from Mancini AJ, Krowchuk DP eds. Pediatric Dermatology: A Quick Reference Guide. 3rd ed. Elk Grove Village, IL: American Academy of Pediatrics; 2016 Of the following, the MOST appropriate treatment is", "options": ["benzoyl peroxide administered topically", "benzoyl peroxide/clindamycin administered topically", "benzoyl peroxide/clindamycin and a retinoid administered topically", "doxycycline administered orally and benzoyl peroxide administered topically"]}, "108": {"stem": "A 2-month-old female infant with poor feeding and failure to gain weight is seen for evaluation. She is fed 24 kcal/oz of appropriately prepared infant formula. She was born at 39 weeks’ gestation, and her birth weight was 3 kg. She failed her newborn hearing screening. She had one hospital admission with vomiting and diarrhea at 6 weeks after birth. Her weight is currently at the third percentile, and her height is at the fifth percentile. Her cardiac examination reveals no murmur, and her chest is clear to auscultation. The rest of her physical examination find‐ ings are unremarkable. Laboratory data are shown: Laboratory Test Result Blood Sodium 134 mEq/L (134 mmol/L) Potassium 3.2 mEq/L (3.2 mmol/L) Chloride 110 mEq/L (110 mmol/L) Bicarbonate 14 mEq/L (14 mmol/L) Blood urea nitrogen 10 mg/dL (3.6 mmol/L) Creatinine 0.2 mg/dL (18 µmol/L) Glucose 90 mg/dL (5.0 mmol/L) Urine pH 7.0 Specific gravity 1.015 Urinalysis with microscopy Normal Sodium 60 mEq/L (60 mmol/L) Potassium 10 mEq/L (10 mmol/L) Chloride 55 mEq/L (55 mmol/L) Of the following, the MOST likely diagnosis for this child is", "options": ["congenital adrenal hyperplasia", "distal renal tubular acidosis", "methylmalonic acidemia", "postinfectious diarrhea"]}, "109": {"stem": "A 10-year-old girl has had a chronic wet cough, present day and night, for 6 months. She has no identified triggers. It is not exacerbated by exercise and does not limit her in any way. There is no seasonal pattern and no tobacco smoke or other irritant exposure. There is a pet dog in the home. Review of systems finds nasal congestion with‐ out rhinorrhea. The family history is negative for asthma, allergies, and immunodeficiency. Physical examination shows mildly edematous nasal mucosa without discharge. The oropharynx and chest wall anatomy are normal. Breath sounds are somewhat coarse with a few scattered rhonchi and no fine rales or wheezes. Spirometry find‐ ings are normal. Chest radiography demonstrates a mild increase in central peribronchial markings with no other abnormalities. Of the following, the BEST next management step for this patient is", "options": ["computed tomography of the chest", "measurement of quantitative immunoglobulin levels", "removal of the dog from the home", "3-week course of amoxicillin/clavulanic acid"]}, "111": {"stem": "A 3-year-old boy with fatigue and bruising is brought to the emergency department. His parents state that he was well until about 2 days ago, when his energy level decreased. The boy had been previously well, with normal growth and development. He appears pale and quietly clings to his mother. He is responsive but sleepy. He has a temperature of 38.6°C, a heart rate of 136 beats/min, a blood pressure of 78/56 mm Hg, a respiratory rate of 32 breaths/min, and an oxygen saturation of 94% on room air. The heart rhythm is normal but rapid, and the lungs are clear to auscultation. The spleen and liver are both markedly enlarged. There are petechiae and purpura over the chest, back, arms, and legs. Laboratory data are shown: Laboratory Test Result White blood cell count 91,900/µL (91.9 × 109/L) Hemoglobin 4.2 g/dL (42 g/L) Platelet count 46,000/µL (46 × 109/L) Of the following, the pattern of results MOST likely to be seen on further laboratory evaluation is Phosphorus level Potassium level Uric acid level", "options": ["High High High", "Low High High", "High Low High", "High High Low"]}, "112": {"stem": "A 15-year-old adolescent girl is evaluated in the office for a 2-month history of chronic nonproductive cough asso‐ ciated with fatigue, 5- to 10-lb weight loss, low-grade fever, and mildly painful nodules on her arms and legs. She has not traveled out of the state or had any known sick exposures. On pulse oximetry, her oxygen saturation is 98% on room air. On physical examination, the girl has no respiratory distress, and no crackles or wheezes are heard. She has several 1- to 3-cm diameter, tender, nonerythematous, nonexcoriated nodules on the extensor sur‐ faces of both arms and legs. Chest radiography suggests hilar adenopathy. Computed tomography additionally demonstrates interstitial changes in the pulmonary parenchyma. Pulmonary function testing shows a mild restric‐ tive pattern with a decrease in forced vital capacity and total lung capacity. Carbon monoxide diffusion is slightly decreased for age and hemoglobin concentration. A tuberculin skin test has a negative result 60 hours after placement. Of the following, the BEST next step in the evaluation of this adolescent is", "options": ["biopsy of a skin nodule", "bronchoscopy and bronchoalveolar lavage", "repeat spirometry after administration of albuterol", "6-minute walk test"]}, "113": {"stem": "A neonate born at term is being evaluated in the newborn nursery. She was born overnight via vaginal delivery to a 27-year-old gravida 1, para 0 woman with a history of asthma. The mother’s prenatal records report group B Streptococcus–negative status and a positive VDRL test (1:2) result with positive treponemal test. The neonate has unremarkable physical examination findings. She is breastfeeding well. Of the following, the BEST next diagnostic test for this neonate is", "options": ["direct fluorescent antibody", "Treponema pallidum enzyme immunoassay", "rapid plasma reagin", "treponemal polymerase chain reaction"]}, "114": {"stem": "A 4-year-old boy is seen for a health supervision visit. He has eczema and has had recurrent ear infections that re‐ quired the placement of myringotomy tubes. He attends preschool, knows his letters, and can draw a triangle and a square. He is interactive during the physical examination. His height is at the 30th percentile, his weight is at the 50th percentile, and his head circumference is at the 70th percentile. He can hop on one foot for 2 seconds and sing his favorite nursery rhyme. His mother reports that his father, paternal uncle, and grandmother have short stature, a large head, small fingers, and shortening of both arms and thighs. His father has been relatively healthy except for obstructive sleep apnea. His grandmother had stenosis of the lumbar spine and hearing loss. His uncle recently had a newborn son with a large head and short limbs who underwent ventriculoperitoneal shunt insertion because of obstructive hydrocephalus. Of the following, the inheritance pattern of the disorder MOST likely seen in this family is", "options": ["autosomal dominant with complete penetrance", "autosomal dominant with incomplete penetrance", "X-linked dominant", "X-linked recessive"]}, "115": {"stem": "A previously healthy, 3-year-old boy has complained intermittently of pain in the left ear for the last 4 weeks. He had rhinorrhea and a cough around the time the pain began, which self-resolved. He has not had any fevers. He is developing appropriately. On physical examination, the boy appears well. He has no rhinorrhea or nasal conges‐ tion. His right tympanic membrane appears gray and translucent with good landmarks. His left tympanic mem‐ brane appears gray with clear fluid visible behind it (Figure 115). Figure 115: Left tympanic membrane of the boy described in the vignette. Courtesy of J McClay. Of the following, the BEST next step in management of this boy’s condition is to", "options": ["monitor clinically for 2 months", "prescribe an antihistamine", "refer for a hearing evaluation", "refer for tympanostomy tube placement"]}, "116": {"stem": "A 6-month-old girl with Down syndrome and a complete atrioventricular septal defect is admitted for surgical repair of the heart defect. On postoperative day 5, she develops a fever. Her vital signs include a temperature of 39.6°C, heart rate of 158 beats/min, respiratory rate of 53 breaths/min, and blood pressure of 85/41 mm Hg. She is receiv‐ ing mechanical ventilation. Her breath sounds are coarse. There is a II/VI systolic murmur, and the liver edge is palpable 3 cm below the costal margin. Laboratory tests show the following: Laboratory Test Result White blood cells 14,500/µL (14.5 × 109/L) Hemoglobin 9.0 g/dL (90 g/L) Platelet count 270 × 103/µL (270 × 109/L) Differential count 72% segmented neutrophils, 12% lymphocytes, 16% monocytes C-reactive protein 5.9 mg/L (56 nmol/L) Blood culture Enterococcus gallinarum Urinalysis Slightly cloudy, protein 1+, nitrite negative, leukocyte negative Of the following, the diagnostic study MOST indicated in this patient is", "options": ["abdominal ultrasonography", "chest radiography", "echocardiography", "urine culture"]}, "117": {"stem": "A 14-year-old basketball player is being evaluated for a recurrent left ankle injury. Several days ago he sustained his third inversion injury to this ankle over the past several months. These injuries result in mild swelling over the lateral ankle for several days, which he treats with a compression wrap, ice, and several doses of ibuprofen. He was able to return to full basketball participation within 7 to 10 days after each injury. However, with the current in‐ jury, the ankle feels unstable and he tapes it before practice. The patient is otherwise healthy. On physical exami‐ nation, the adolescent’s left ankle is slightly swollen and minimally tender inferior to the lateral malleolus. He has full and pain-free strength and range of motion in both ankles. There is increased laxity with anterior drawer testing on the left compared with the right. His gait is normal and he moves comfortably throughout the evaluation. The adolescent has some difficulty with single leg hop and balance testing on the left leg compared with the right. Of the following, the BEST next step in management for this patient is", "options": ["anteroposterior and lateral ankle radiography", "magnetic resonance imaging of the left ankle", "referral to a physical therapist", "use of an ankle-stabilizing brace"]}, "118": {"stem": "A 5-year-old boy is seen in the office for concerns of pubic hair growth and penile enlargement. During a recent bath, his mother noticed pubic hair and thought his penis looked too large. He has no significant medical history. His newborn screen was normal, including a 17-hydroxyprogesterone level. There is no family history of preco‐ cious puberty. His vital signs are normal for age. His height and weight are at the 95th and 75th percentile, respec‐ tively. He has mild acne over his forehead and a small amount of axillary hair. He has a pubertal-sized penis, and his sexual maturity rating is 3 for pubic hair. His testes are 2 mL in volume bilaterally. The remainder of his physical examination findings are unremarkable. Laboratory data are shown: Laboratory Test Resulta Luteinizing hormone <0.1 mIU/mL (reference range, 0.02-0.3 mIU/mL) Follicle-stimulating hormone 0.6 mIU/mL (reference range, 0.26-3 mIU/mL) Testosterone 210 ng/dL (7.3 nmol/L) (reference range, <2.5-10 ng/dL [0.1- 0.4 nmol/L]) Dehydroepiandrosterone sulfate 1,600 µg/dL (43.2 µmol/L) (reference range, 13-83 µg/dL [0.4-2.2 µmol/L]) a Reference ranges are for individuals younger than 10 years. The result of bone age radiography is 8 years. Of the following, the MOST likely source of this boy’s precocious puberty is", "options": ["exogenous steroids", "his adrenal gland", "his central nervous system", "his gonads"]}, "119": {"stem": "A 3-year-old boy is brought to the office by his mother for a health supervision visit. His mother is planning to enroll him in preschool, but is uncertain which educational setting would be best. The boy speaks in 3-word sentences/phrases and follows 3-step commands. He can balance on each foot for 3 seconds. He can draw lines and stack up to 3 blocks. The boy knows his sex and age. He can match letters. He enjoys playing with other chil‐ dren and has an easy temperament. He is toilet trained. The boy has no significant medical history and his growth and physical examination findings are within normal limits. Of the following, the MOST appropriate recommendation is a", "options": ["general education program", "general education program with specialized academic instruction", "general education program with physical therapy", "special education program"]}, "120": {"stem": "Four patients in the emergency department are being evaluated for bruising or bleeding. In room 1, a 3-year-old girl has a 4-cm, raised, purple hematoma in the middle of her forehead. She also has purple discoloration under her eyes and bruises on her elbows and shins. Her parents report that yesterday she was riding a wheeled toy in the house and fell down a flight of 6 stairs. She landed on ceramic tile on all 4 extremities and hit her head. Her laboratory data are shown: Laboratory Test Result White blood cell count 8,400/µL (8.4 × 109/L) Hemoglobin 12.1 g/dL (121 g/L) Platelet count 352 × 103/µL (352 × 109/L) Prothrombin time 12.9 s Partial thromboplastin time 33 s In room 2, a 5-year-old boy has epistaxis that has lasted for 30 minutes despite continuous pressure applied by his mother. She reports that he experiences epistaxis approximately every other day. She also reports that his gums often bleed when he brushes his teeth and that he always seems to be bruised. His laboratory data are shown: Laboratory Test Result White blood cell count 9,540/µL (9.5 × 109/L) Hemoglobin 12.6 g/dL (126 g/L) Platelet count 248 × 103/µL (248 × 109/L) Prothrombin time 12.7 s Partial thromboplastin time 30.1 s In room 3, a 12-year-old boy has had bruising on his shins and upper arms for the last couple of weeks. He has a seizure disorder that has been well controlled on levetiracetam for the last year. He states that he has been feeling well and has not had any seizures or trauma. His laboratory data are shown: Laboratory Test Result White blood cell count 5,420/µL (5.4 × 109/L) Hemoglobin 11.3 g/dL (113 g/L) Platelet count 21 × 103/µL (21 × 109/L) Prothrombin time 11.5 s Partial thromboplastin time 29.2 s In room 4, a 4-year-old girl has a “rash” and bruises on her extremities that started 2 days ago. She had been pre‐ viously healthy with normal growth and development. She has petechiae on her face, upper chest, arms, and legs, as well as ecchymoses of various sizes on her arms and legs. Her laboratory data are shown: Laboratory Test Result White blood cell count 7,520/µL (7.5 × 109/L) Hemoglobin 12.1 g/dL (121 g/L) Platelet count 2.0 × 103/µL (2.0 × 109/L) Prothrombin time 13 s Partial thromboplastin time 31.2 s Of these 4 patients, the child MOST likely to have a heritable bleeding diathesis is in", "options": ["room 1", "room 2", "room 3", "room 4"]}, "123": {"stem": "A 16-year-old adolescent is brought to the emergency department by ambulance after he was found wandering outside at 2 am. He is accompanied by a friend who reports that the patient ingested an over-the-counter cough and cold medication that night in order to get high. The patient is uncooperative and agitated. He is not oriented to place or situation. He has a heart rate of 140 beats/min, blood pressure of 125/90 mm Hg, respiratory rate of 12 breaths/min, and oxygen saturation of 100% in room air. He is diaphoretic, and his pupils are dilated. Of the following, the ingredient that is MOST likely responsible for the adolescent’s signs and symptoms is", "options": ["acetaminophen", "chlorpheniramine", "dextromethorphan", "guaifenesin"]}, "124": {"stem": "A male neonate is evaluated in the nursery. He is stable on room air. He has midface hypoplasia, up-slanting palpebral fissures, epicanthal folds, single transverse palmar crease, and wide gaps between the first and second toes. An echocardiogram shows an atrioventricular canal defect. A karyotype for the neonate shows trisomy 21 with an unbalanced translocation of chromosomes 14 and 21. On the basis of this result, karyotypes for both par‐ ents are recommended. Of the following, the karyotype that carries the HIGHEST risk of recurrence of this syndrome for these parents in subsequent pregnancies is", "options": ["45,XY,t(14;21) in the father", "45,XX,t(14;21) in the mother", "46,XY,t(14;21) in the newborn", "47,XY,+21 in the newborn"]}, "125": {"stem": "A 2-year-old girl, not yet toilet trained, is being evaluated for diarrhea. She began having loose stools 4 months ago, and now has 4 to 6 nonbloody stools daily. Her first-morning stool tends to be somewhat formed. As the day progresses, her stools become looser, with mucus and whole pieces of food present. She has frequent diaper rashes that resolve after a single application of over-the-counter diaper cream. The girl is gaining weight well and meeting her developmental milestones. Her mother is lactose-intolerant and has been keeping lactose out of the girl’s diet; the girl has no other diet restrictions. She drinks 24 oz of juice and 20 oz of lactose-free whole milk daily. Her favorite foods are pancakes and syrup, peanut butter and jelly sandwiches, and spaghetti and meatballs. Her medical and surgical history are unremarkable. Her weight is 12.6 kg (50th percentile), length is 87 cm (40th per‐ centile), and body mass index is 17 kg/m2 (67th percentile). She is well nourished and interactive. Her abdomen is soft and nontender, with mild distention. She has no diaper rash. The remainder of the physical examination find‐ ings are within normal limits. Of the following, the dietary intervention MOST likely to improve the girl’s symptoms is reduced consumption of", "options": ["cow milk protein", "fat", "fructose", "gluten"]}, "126": {"stem": "A 4-month-old infant with a 3-day history of rhinorrhea, cough, and increased work of breathing is brought to the emergency department. Her medical history is remarkable for premature birth at 31 weeks’ gestation and one episode of reactive airway disease at 2 months of age that required hospitalization. She appears ill. She has a temperature of 37.7°C, a heart rate of 158 beats/min, a respiratory rate of 56 breaths/min, a blood pressure of 76/48 mm Hg, and an oxygen saturation of 91% on room air. Chest examination is remarkable for subcostal and intercostal retractions and bilateral diffuse expiratory wheezes. The remainder of her physical examination findings are normal. Laboratory data are shown: Laboratory Test Result White blood cell count 12,000/µL (12.0 × 109/L) Lymphocytes 65% Polymorphonuclear leukocytes 25% Monocytes 10% Direct fluorescent antibody assay of nasopharyngeal swab is negative for respiratory syncytial virus. A chest radio‐ graph shows peribronchial cuffing, air trapping, and patchy areas of atelectasis. Of the following, the MOST likely cause of this child’s illness is", "options": ["adenovirus", "bocavirus", "human metapneumovirus", "influenza virus"]}, "127": {"stem": "A 2-week-old female infant is seen during rounds in the neonatal intensive care unit. The infant was delivered at 32 weeks’ gestation because of maternal preeclampsia; she was small for gestational age with a birthweight of 1,200 g. Her neonatal course was complicated by mild respiratory distress requiring nasal continuous positive airway pressure for the first 4 days after birth and unconjugated hyperbilirubinemia for which she received 3 days of pho‐ totherapy in the first week after birth. She tolerated enteral feeding well, and was receiving fortified breast milk. However, her mother’s milk supply has decreased and the infant was recently switched to a cow milk–based pre‐ mature formula. She is growing well and takes a combination of oral and nasogastric feedings without difficulty. Her parents ask about using a cow milk–based formula designed for term infants. Of the following, the condition this neonate would be MOST at risk for, with the use of this suggested formula, is", "options": ["acrodermatitis enteropathica", "cow milk protein allergy", "hypervitaminosis A", "osteopenia of prematurity"]}, "128": {"stem": "The mother of a girl who is 6 years and 10 months old expresses concerns about her daughter’s poor school per‐ formance. The girl started kindergarten in the fall. She was hesitant to engage in class activities and was teased by her classmates for her small size. In comparison with her classmates, she required additional guidance and support from her teachers to understand class routines and class lessons. After a few weeks, she was moved to a transitional kindergarten class, where the girl adjusted well and made several friends. Her teacher recently in‐ formed the girl’s mother that she is performing at a level appropriate for the class. Her mother is concerned about why her daughter was not successful in kindergarten and would like additional guidance. The girl has no significant medical history. She walked at age 12 months, spoke single words at age 11 months, and spoke in 2-word phrases/sentences at age 2 years. Her height and weight are at the 10th percentile. During the visit, the girl initially stays close to her mother and is quiet, but eventually engages in a brief conversation about the toy unicorn she has brought. Physical examination findings are within normal limits; vision and hearing screening results are normal. Of the following, the MOST appropriate next step is to recommend", "options": ["cognitive behavioral therapy", "genetic testing", "psychoeducational evaluation", "reassessment in the fall"]}, "129": {"stem": "A 15-year-old female soccer player is being evaluated for a 1-year history of progressive left groin pain. She de‐ nies trauma or change in activity before the onset of symptoms. The pain is primarily anterior, but at times radiates into the lateral hip as well. Symptoms worsen with physical activity, particularly running and jumping. She has not been able to participate in soccer training for the past week because of the pain. She denies swelling, change in bowel or bladder function, or any distal neurovascular complaints and is otherwise healthy, with normal growth and development. On physical examination, the adolescent is in no acute distress. Her gait is antalgic; abdominal and genitourinary examinations are normal; lumbar spine has free range of motion; and her lower extremity neurovas‐ cular examination findings are normal. There is mild tenderness on examination of the left anterior hip and groin, but no swelling or inguinal lymphadenopathy is appreciated. Flexion and internal rotation of the left hip are painful and limited compared with the right. Of the following, the BEST next management step for this adolescent is to", "options": ["obtain a complete blood cell count, C-reactive protein level, and erythrocyte sedimentation rate", "perform magnetic resonance imaging of the left hip", "perform standing radiography of the pelvis and left hip", "prescribe a nonsteroidal anti-inflammatory medication and physical therapy"]}, "130": {"stem": "A 38-month-old boy is brought to clinic in July to establish care. He emigrated from El Salvador 3 months ago. He has no significant medical history, allergies, or medications. He and his mother were detained at the border in a family shelter while awaiting reunification with family members. He underwent basic medical screening, including tuberculosis screening, which had negative results, and received vaccinations. His mother brings his vaccine record from El Salvador, indicating that he received a combination vaccine of hepatitis B, DTaP, and inactivated polio at 2, 4, and 6 months of age. Two months ago at the border shelter, he received Haemophilus influenzae type B, DTaP, MMR, pneumococcal conjugate, and varicella vaccines. In addition to hepatitis A, the most appropriate vaccine(s) for this boy at this time is (are)", "options": ["DTaP", "Haemophilus influenzae type B and pneumococcal conjugate", "Haemophilus influenzae type B, pneumococcal conjugate, and DTaP", "none"]}, "131": {"stem": "A patient with sepsis is receiving two antibiotics in the pediatric intensive care unit. The antibiotic plasma concen‐ trations are tracked over time (Figure 131). Figure 131: Antibiotic plasma concentrations over time. Courtesy of J Kane Of the following, the BEST explanation for the difference in the plasma concentration curves for the two drugs is that the patient has", "options": ["become hypermetabolic because of exogenous catecholamine infusions", "decreased glomerular filtration and drug B has renal metabolism", "increased hepatic blood flow and drug B has hepatic metabolism", "started renal replacement therapy and drug B has renal metabolism"]}, "132": {"stem": "Three adolescents are brought to the emergency department 2 days after attending a political rally at which a small explosion occurred near them. None of the girls sustained any physical injuries, so they did not seek immedi‐ ate medical care. Later that evening, all three began to have nonbloody nonbilious vomiting, diarrhea, mild headache, and fatigue, which has persisted. In the emergency department, all three adolescents appear well and have normal vital signs. On physical examination, each patient has mild diffuse abdominal tenderness and one ap‐ pears to be mildly dehydrated. The remainder of their physical examination findings are normal. Intravenous lines are placed and a bolus of normal saline is administered to each adolescent. All three have a decreased absolute lymphocyte count, but laboratory findings are otherwise normal. Of the following, the MOST likely cause of the adolescents’ symptoms is exposure to", "options": ["anthrax", "phosgene gas", "radiation", "VX gas"]}, "133": {"stem": "A 2-day-old neonate is nearly ready to be discharged. He was born at 39 weeks’ gestation without any complica‐ tions during pregnancy or delivery. He is feeding well and has voided and passed stools. His vital signs, including oxygen saturation, have been normal since birth. Despite several attempts, he failed the otoacoustic emission test. Before discharge, repeat otoacoustic emission testing is arranged. Of the following, based on current care guidelines, the MOST appropriate timeframe for the completion of this testing is within", "options": ["1 month", "3 months", "6 months", "9 months"]}, "135": {"stem": "A 15-year-old adolescent girl is brought to the office by her mother for evaluation of irregular periods. She had menarche at age 12 years, and her periods were regular for the first 1.5 to 2 years. Over the past 12 months, she has had a period every 1 to 3 months. Her last menstrual period was 4 months ago. Since her health supervision visit 1 year ago, she has gained 9 kg, which she attributes to a poor diet. She has had intermittent flares of acne but no headaches, visual changes, abnormal hair growth, or nipple discharge. There is no family history of men‐ strual disorders. During the confidential psychosocial interview, she reports that she has never been sexually ac‐ tive. She has a temperature of 37°C, a heart rate of 80 beats/min, a blood pressure of 120/80 mm Hg, and a respi‐ ratory rate of 18 breaths/min. She has a weight of 68 kg (>90th percentile), height of 164 cm (50th percentile), and body mass index of 25.7 kg/m2 (92nd percentile). She has scattered closed comedones on her forehead and cheeks and mild hair growth on her upper lip and lower abdomen. The remainder of her physical examination find‐ ings are unremarkable. Of the following, the test(s) MOST likely to help confirm the diagnosis is (are)", "options": ["follicle-stimulating hormone and luteinizing hormone", "free and total testosterone", "thyroid-stimulating hormone and free thyroxine", "urine human chorionic gonadotropin"]}, "136": {"stem": "A 3-month-old infant is being evaluated for a hoarse cry of 2 weeks’ duration. His mother is concerned about noisy breathing and progressive difficulty feeding. On physical examination, his vital signs are normal and he has an oxygen saturation of 98% on pulse oximetry. He has mild inspiratory stridor with increased work of breathing and intercostal retractions. His breath sounds are clear. Cardiovascular examination findings are normal. No hep‐ atosplenomegaly is noted. Of the following, the finding that would be MOST helpful in making a diagnosis is", "options": ["eczema in flexural creases and scalp", "family history of asthma and allergies", "hemangioma of the scalp and lower lip", "history of prenatal tobacco smoke exposure"]}, "137": {"stem": "A 16-year-old adolescent girl is seen in the office for evaluation of bruising on her knees and ankles. She has no significant bleeding history and has had regular monthly menses lasting 6 days each. She has not been taking any medications, vitamins, or supplements. She reports that she plays on the school soccer team and is frequently kicked. Her physical examination findings are remarkable only for nonpalpable bruises of various sizes and ages on her ankles and around her knees. She is reassured that her bruising is likely related to her soccer participation. A complete blood cell count reveals the following: Laboratory Test Result White blood cell count 4,500/µL (4.5 × 109/L) Hemoglobin 9.7 g/dL (97 g/L) Platelet count 128 × 103/µL (128 × 109/L) Absolute neutrophil count 1,040/µL (1.0 × 109/L) Mean corpuscular volume 110 fL Reticulocytes 0.2% On review of these results, the clinician orders the following additional laboratory tests: Laboratory Test Result Ferritin 96 ng/mL (216 pmol/L) Vitamin B12 502 pg/mL (370 pmol/L) (reference range, 200-900 pg/mL [148-664 pmol/L]) Folate 11 ng/mL (25 nmol/L) (reference range, 2-20 ng/mL [5-45 nmol/L]) Of the following, the test MOST likely to confirm the diagnosis is", "options": ["anti-intrinsic factor antibody", "bone marrow biopsy", "flow cytometry for lymphoblasts", "serum polymerase chain reaction for parvovirus"]}, "138": {"stem": "A healthy, 5-year-old girl is brought to the office to discuss concerns of unusual behavior. Her parents report that over the past several months, their daughter has been masturbating, touching her mother’s breasts, and asking her father if he can kiss her “vagi-gi.” Her parents report that her teacher has observed her trying to engage in sex‐ ual activity with male classmates. They note that the behaviors seemed to start after a family friend visited them during a holiday weekend. Her temperament has otherwise been normal. Their marriage has been healthy and they have tried to raise their daughter in an emotionally safe and supportive environment. They have never ex‐ posed her to age-inappropriate media. Her vital signs, growth parameters, and physical examination findings are normal. Of the following, her behavior may be BEST attributed to", "options": ["age-appropriate behavior", "gender dysphoria", "posttraumatic stress disorder", "sexual abuse"]}, "139": {"stem": "An 8-week-old male infant with tachypnea and poor oral intake is brought to the emergency department. He was born at full term and has no relevant medical history. His parents report that he has been eating less and breathing fast, seems tired, and becomes sweaty with feedings. He has a heart rate of 170 to 180 beats/min, a blood pres‐ sure of 75/45 mm Hg, a respiratory rate of 60 breaths/min with mild subcostal retractions, and oxygen saturation of 95% by pulse oximetry. He is irritable but consolable. Diffuse crackles are heard on auscultation. He has a gallop rhythm and a grade 2/6 blowing systolic murmur at the apex. His abdomen is soft and nontender. His liver edge is palpable 3 cm below the right costal margin. He is cool distally and warm centrally. A chest radiograph (Figure 139A) and an electrocardiogram (Figure 139B) are obtained. Figure 139B: Electrocardiogram for the infant described in the vignette. Reprinted with permission from Harper B. Index of suspicion. Pediatr Rev. 2017;38(7):340 Figure 139A: Chest radiograph for the infant described in the vignette. Reprinted with permission from Harper B. Index of suspicion. Pediatr Rev. 2017;38(7):338. Of the following, the infant’s MOST likely diagnosis is", "options": ["anomalous coronary artery from the pulmonary artery", "aortopulmonary window", "dilated cardiomyopathy", "tricuspid atresia"]}, "140": {"stem": "A newborn is seen in a clinic for his first visit after discharge from the neonatal intensive care unit. He was born vaginally at term to first-time parents after an uncomplicated pregnancy. At delivery, he was noted to have clusters of blisters on his right hand, his posterior neck, and his left upper arm. An infectious evaluation had negative re‐ sults. Skin biopsy with immunofluorescence microscopy mapping showed staining of basement membrane anti‐ gens in the floor of the blister, consistent with intraepidermal cleavage seen in epidermolysis bullosa. During his hospitalization, the neonate developed several oral blisters. His parents have been educated on skin and oral care for his condition. They have questions about his long-term prognosis and the likelihood that he will develop other medical problems. Of the following, the MOST common extracutaneous manifestation of this boy’s condition is", "options": ["blindness", "hepatic fibrosis", "malnutrition", "nephritis"]}, "142": {"stem": "A 17-year-old adolescent girl is being evaluated for leg weakness. Over the last week, she has developed clumsi‐ ness and tripping that progressed to an inability to walk. She reports difficulty urinating and constipation. She has no history of trauma and denies the use of birth control pills or other medications. She notes that she had an episode of “blurry vision” which self-resolved about 3 months ago. Neurologic examination is notable for significant weakness of the lower extremities with absent deep tendon reflexes in the legs and lack of sensation to pinprick, vibration, and temperature. Her rectal tone is diminished. She has normal strength and sensation in the upper ex‐ tremities. Magnetic resonance imaging (MRI) of the spine reveals a longitudinal extensive transverse myelitis. Brain MRI findings are normal. Cerebrospinal fluid analysis shows a lymphocytic pleocytosis with elevated protein and normal glucose. Ophthalmologic examination reveals optic atrophy of the right fundus. She is admitted to the pediatric intensive care unit and emergently treated with high-dose methylprednisolone. Of the following, the MOST likely etiology of her disorder is", "options": ["autoimmune", "postinfectious", "trauma", "vascular"]}, "143": {"stem": "A previously healthy, 13-year-old adolescent boy with an abrupt onset of emesis, abdominal cramps, and watery diarrhea is seen in the emergency department. One day ago, he visited a local park with his younger siblings. The public park has a picnic ground, lake, paddle boats, and a splash pad. The patient’s siblings who swam at the lake with him are also ill with a similar gastrointestinal illness. He has a temperature of 38.1°C, dry mucous mem‐ branes, and sunken eyes. Capillary refill time is 3 seconds. The rest of the examination findings are unremarkable. Laboratory evaluation reveals a serum sodium concentration of 128 mEq/L (128 mmol/L). Of the following, the MOST likely cause of this illness is", "options": ["Campylobacter", "Cryptosporidium", "norovirus", "Salmonella"]}, "145": {"stem": "A 7-year-old boy with a history of renal dysplasia and chronic kidney disease is seen for a health supervision visit. He has a history of increased thirst and polyuria. His current medications include sodium bicarbonate, ferrous sul‐ fate, calcium carbonate, and calcitriol. His weight is at the fifth percentile, and his height is at the third percentile. He has a heart rate of 89 beats/min, a respiratory rate of 16 breaths/min, and a blood pressure of 90/60 mm Hg. The rest of the examination findings are unremarkable. Of the following, the MOST appropriate dietary restriction for this child is", "options": ["phosphorus", "protein", "sodium", "vitamin D"]}, "146": {"stem": "A 9-year-old girl is being evaluated for concerns about learning. She was recently diagnosed via psychoeduca‐ tional evaluation as having dyslexia and attention-deficit/hyperactivity disorder, predominantly inattentive presenta‐ tion. She is a polite girl who is well-liked by her peers and teacher. She tries but struggles with staying on task and with reading fluency and comprehension. Her parents are not interested in medication and have hired a tutor to work with their daughter after school. Her parents would like to know how to best support their daughter. Of the following, the BEST recommendation is", "options": ["a behavioral intervention plan", "a student success team meeting", "sensory integration therapy", "specialized academic instruction"]}, "147": {"stem": "A 7-day-old female newborn had an abnormal result on newborn screening revealing an absence of T-cell receptor excision circles (TREC), which raises concern regarding severe combined immunodeficiency. Of the following, the MOST appropriate next test to confirm the diagnosis is", "options": ["a complete blood cell count with differential", "flow cytometry for dihydroxy-rhodamine123 reduction", "lymphocyte subsets via flow cytometry", "serum immunoglobulin subsets"]}, "149": {"stem": "A 10-year-old boy is seen for a health supervision visit. He and his mother are concerned about his short stature. He is otherwise healthy, takes no medications, and is doing well in school. Findings of a comprehensive review of systems are unremarkable. His adjusted midparental height is at the 25th percentile. Both parents had typical pu‐ bertal timing. His vital signs are normal for age. The boy’s growth chart is shown in Figure 149. His body mass in‐ dex is at the 66th percentile. An upper-to-lower body segment ratio is calculated as 1.2 (normal, 1). His sexual ma‐ turity rating is 1. The remainder of his physical examination findings are unremarkable. A bone age radiograph is read as concordant with his chronological age. Figure 149: Growth chart for the boy described in the vignette. Of the following, the MOST likely diagnosis for this boy is", "options": ["familial short stature", "constitutional delay of growth and puberty", "growth hormone deficiency", "a skeletal dysplasia"]}, "150": {"stem": "A 3-month-old infant is admitted to the hospital for diarrhea and dehydration; this is his second admission in 3 weeks for the same symptoms. He has had 4 weeks of loose, watery stools 15 to 20 times every day, with persis‐ tent diaper rash. He is exclusively breastfed. Today, for the first time, his parents have seen streaks of blood in his stools. He has had difficulty gaining weight recently. The infant was born at term and passed meconium within the first 24 hours after birth. His family history is notable for environmental allergies in both parents. His physical ex‐ amination findings demonstrate weight and length less than the 3rd percentile; his abdomen is soft, distended, and without hepatosplenomegaly; he has pitting edema of both legs. Laboratory testing shows his serum albumin to be 1.8 g/dL (18 g/L). Of the following, the test MOST likely to identify the cause of the infant’s condition is a(n)", "options": ["ammonia level", "echocardiography", "fecal α1-antitrypsin level", "urinalysis"]}}, "clave": {"1": "c", "2": "d", "3": "b", "4": "a", "5": "d", "6": "d", "7": "b", "8": "a", "9": "d", "10": "c", "11": "a", "12": "c", "13": "b", "14": "d", "15": "c", "16": "d", "17": "b", "18": "d", "19": "b", "20": "b", "21": "d", "22": "c", "23": "c", "24": "a", "25": "a", "26": "b", "27": "c", "28": "c", "29": "a", "30": "c", "31": "b", "32": "a", "33": "c", "34": "c", "35": "d", "36": "d", "37": "b", "38": "b", "39": "c", "40": "c", "41": "b", "42": "a", "43": "a", "45": "b", "46": "d", "47": "a", "48": "c", "49": "a", "50": "a", "51": "b", "52": "a", "53": "d", "54": "a", "55": "b", "56": "d", "57": "a", "58": "b", "59": "c", "60": "c", "61": "d", "62": "c", "63": "c", "64": "a", "65": "b", "66": "b", "67": "c", "68": "c", "69": "d", "70": "b", "71": "b", "72": "a", "73": "c", "74": "b", "75": "d", "76": "b", "77": "d", "78": "a", "79": "d", "80": "b", "81": "b", "82": "c", "83": "c", "84": "a", "85": "a", "86": "c", "87": "a", "88": "c", "89": "b", "90": "d", "91": "b", "92": "b", "93": "c", "94": "b", "95": "b", "96": "b", "97": "c", "98": "d", "99": "c", "100": "d", "101": "a", "102": "b", "103": "d", "104": "d", "105": "d", "106": "d", "107": "a", "108": "b", "109": "d", "111": "a", "112": "a", "113": "c", "114": "a", "115": "a", "116": "c", "117": "c", "118": "b", "119": "a", "120": "b", "123": "c", "124": "b", "125": "c", "126": "c", "127": "d", "128": "c", "129": "c", "130": "d", "131": "b", "132": "c", "133": "b", "135": "b", "136": "c", "137": "b", "138": "d", "139": "a", "140": "c", "142": "a", "143": "c", "145": "a", "146": "d", "147": "c", "149": "d", "150": "c"}};
