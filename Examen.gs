EXAM.materiasItems = {"Neonatología": [2, 19, 38, 41, 52, 55, 62, 64, 91, 97, 113, 127, 133], "Medicina crítica": [35, 67, 85], "Gastroenterología y nutrición": [28, 36, 45, 50, 59, 81, 101, 125, 150], "Errores innatos del metabolismo": [89, 102], "Neumología": [6, 11, 87, 92, 109, 112], "Farmacología y toxicología": [27, 57, 93, 123, 131], "Urgencias pediátricas": [29, 49, 54, 132], "Líquidos y electrolitos": [51, 100], "Hematología y oncología": [8, 16, 47, 61, 66, 111, 120, 137], "Genética": [13, 26, 37, 74, 82, 114, 124], "Ortopedia": [48, 63, 86, 129]};
